code main:

    public main;

    asm {
main:
        jsr ReadCPU
        jsr WBStartup       ; pick up Workbench message (no-op from CLI)
        jsr highscore_load_dos
        jsr TakeSystem
        jsr game_start
        jsr free_text_bobs
        jsr ReleaseSystem
        ; pure DOS context here - no system switching needed
        move.b highscore_dirty,d0
        beq.s .no_hs_save
        jsr highscore_save_dos
.no_hs_save:
        jsr DebugFlushToDos
        jmp WBExit          ; Forbid + ReplyMsg, must be last
        rts
    }

    native proc ReadCPU() -> void {
        cpu_type = GetCPUType();
    }

    native proc peek_b(__reg(a0) a: long) -> byte {
        asm {
            moveq #0,d0
            move.b (a0),d0
        }
    }

    // Wait exactly one new video frame (prevents fast CPUs from returning
    // multiple times while the beam is still on the same VBlank line).
    native proc WaitFrame() -> void {
        asm {
            movem.l d0,-(sp)
.wf_leave_line:
            move.l $004(a5),d0
            and.l #$1ff00,d0
            cmp.l #303<<8,d0
            beq.b .wf_leave_line
.wf_next_vblank:
            move.l $004(a5),d0
            and.l #$1ff00,d0
            cmp.l #303<<8,d0
            bne.b .wf_next_vblank
            movem.l (sp)+,d0
        }
    }

    native proc InitSound() -> void {
        asm {
            movem.l    d0/a0/a6,-(sp)

; installs a CIA-B interrupt for calling _mt_music
            lea        $DFF000,a6
            move.l     #0,a0                            ; vectorBase
            moveq      #1,d0                            ; PAL clock
            jsr        _mt_install_cia

; reserves channel 0 for music.
            lea        $DFF000,a6
            move.b     #$01,d0
            jsr        _mt_musicmask

            movem.l    (sp)+,d0/a0/a6
        }
    }

    proc PlaySoundEffect(sfx_id: int) -> void {
        asm {
; plays sound effect on channel 1
            movem.l    a6,-(sp)
            move.l     8(a6),d0        ; d0 = sfx_id parameter
            clr.l d1                   ; 0 = no loop
            jsr        play_sfx
            movem.l    (sp)+,a6
        }
    }

    proc PlayMusic(track_id: int) -> void {
        asm {
; plays pro-tracker music
            movem.l a6,-(sp)
            move.l     8(a6),d0
            cmpi.l     #1,d0
            beq.s      .play_music1
            lea        music,a0
            bra.s      .music_ready
.play_music1:
            lea        music1,a0
.music_ready:
            lea        $DFF000,a6
            move.l     #0,a1
            move.b     #0,d0
            jsr        _mt_init
            move.b     #1,_mt_Enable

; sets master volume for music
            lea        $DFF000,a6
            move.w     #16,d0
            jsr        _mt_mastervol
            movem.l (sp)+,a6
        }
    }

    proc SwitchMusic(track_id: int) -> void {
        asm {
; stops current replay and restarts the CIA-based replayer for a new module
            movem.l    d0/d1/a0/a1/a6,-(sp)
            move.l     8(a6),d1
            movem.l    d1,-(sp)

            move.b     #0,_mt_Enable
            
            lea        $DFF000,a6
            jsr        _mt_end
            jsr        _mt_remove_cia

            move.l     #0,a0
            moveq      #1,d0
            jsr        _mt_install_cia

            movem.l    (sp)+,d1
            cmpi.l     #1,d1
            beq.s      .switch_music1
            cmpi.l     #2,d1
            beq.s      .switch_music2
            lea        music,a0
            bra.s      .switch_music_ready
.switch_music2:
            lea        music2,a0
            bra.s      .switch_music_ready
.switch_music1:
            lea        music1,a0
.switch_music_ready:
            move.l     #0,a1
            move.b     #0,d0
            jsr        _mt_init
            move.b     #1,_mt_Enable

; keeps same master volume as PlayMusic
            move.w     #16,d0
            jsr        _mt_mastervol
            movem.l    (sp)+,d0/d1/a0/a1/a6
        }
    }

    native proc QuitSound() -> void {
        asm {
            movem.l    a6,-(sp)

            lea        $DFF000,a6
            jsr        _mt_end
            jsr        _mt_remove_cia

            movem.l    (sp)+,a6
        }
    }

    proc load_all_sprites() -> int {
        var id:int;

        id = CreateSprite(0, &sprite_J); if(id == -1){return -1;}
        id = CreateSprite(1, &sprite_E); if(id == -1){return -1;}
        id = CreateSprite(2, &sprite_T); if(id == -1){return -1;}
        id = CreateSprite(3, &sprite_P); if(id == -1){return -1;}
        id = CreateSprite(4, &sprite_A); if(id == -1){return -1;}
        id = CreateSprite(5, &sprite_C); if(id == -1){return -1;}
        id = CreateSprite(6, &sprite_J); if(id == -1){return -1;}
        id = CreateSprite(7, &sprite_J); if(id == -1){return -1;}

        // Park copper on chip null sprites; do not kill sprite DMA mid-display
        // (that freezes the last SPRxDAT as a full-height vertical bar).
        for id = 0 to MAX_SPRITES - 1
        {
            HideSprite(id);
        }
        call UpdateSpritePointers();
        return 0;
    }

    proc load_bob_letters() -> int {
        var id:long;

        id = CreateBob(&bob_Letter_J, 1); if (id == -1) { return -1; } asset_letters[0] = id;
        id = CreateBob(&bob_Letter_E, 1); if (id == -1) { return -1; } asset_letters[1] = id;
        id = CreateBob(&bob_Letter_T, 1); if (id == -1) { return -1; } asset_letters[2] = id;
        id = CreateBob(&bob_Letter_P, 1); if (id == -1) { return -1; } asset_letters[3] = id;
        id = CreateBob(&bob_Letter_A, 1); if (id == -1) { return -1; } asset_letters[4] = id;
        id = CreateBob(&bob_Letter_C, 1); if (id == -1) { return -1; } asset_letters[5] = id;

        return 0;
    }

    proc load_all_assets() -> int {
        var id:long;
        var pal:ptr;
        var i:int;

        // Only create BOBs actually referenced by the render loop.
        // Slots [10] and [31-41] are currently left 0 (reserved / null).
        id = CreateBob(&jetpacspritesheet_flyl_000, 1); if (id == -1) { return -1; } asset_handles[11] = id;
        id = CreateBob(&jetpacspritesheet_flyl_001, 1); if (id == -1) { return -1; } asset_handles[12] = id;
        id = CreateBob(&jetpacspritesheet_flyl_002, 1); if (id == -1) { return -1; } asset_handles[13] = id;
        id = CreateBob(&jetpacspritesheet_flyl_003, 1); if (id == -1) { return -1; } asset_handles[14] = id;
        id = CreateBob(&jetpacspritesheet_flyl_004, 1); if (id == -1) { return -1; } asset_handles[15] = id;
        id = CreateBob(&jetpacspritesheet_flyr_000, 1); if (id == -1) { return -1; } asset_handles[21] = id;
        id = CreateBob(&jetpacspritesheet_flyr_001, 1); if (id == -1) { return -1; } asset_handles[22] = id;
        id = CreateBob(&jetpacspritesheet_flyr_002, 1); if (id == -1) { return -1; } asset_handles[23] = id;
        id = CreateBob(&jetpacspritesheet_flyr_003, 1); if (id == -1) { return -1; } asset_handles[24] = id;
        id = CreateBob(&jetpacspritesheet_flyr_004, 1); if (id == -1) { return -1; } asset_handles[25] = id;
        id = CreateBob(&jetpacspritesheet_flylf_000, 1); if (id == -1) { return -1; } asset_handles[16] = id;
        id = CreateBob(&jetpacspritesheet_flylf_001, 1); if (id == -1) { return -1; } asset_handles[17] = id;
        id = CreateBob(&jetpacspritesheet_flylf_002, 1); if (id == -1) { return -1; } asset_handles[18] = id;
        id = CreateBob(&jetpacspritesheet_flylf_003, 1); if (id == -1) { return -1; } asset_handles[19] = id;
        id = CreateBob(&jetpacspritesheet_flylf_004, 1); if (id == -1) { return -1; } asset_handles[20] = id;
        id = CreateBob(&jetpacspritesheet_flyrf_000, 1); if (id == -1) { return -1; } asset_handles[26] = id;
        id = CreateBob(&jetpacspritesheet_flyrf_001, 1); if (id == -1) { return -1; } asset_handles[27] = id;
        id = CreateBob(&jetpacspritesheet_flyrf_002, 1); if (id == -1) { return -1; } asset_handles[28] = id;
        id = CreateBob(&jetpacspritesheet_flyrf_003, 1); if (id == -1) { return -1; } asset_handles[29] = id;
        id = CreateBob(&jetpacspritesheet_flyrf_004, 1); if (id == -1) { return -1; } asset_handles[30] = id;
        id = CreateBob(&jetpacspritesheet_walkl_000, 1); if (id == -1) { return -1; } asset_handles[42] = id;
        id = CreateBob(&jetpacspritesheet_walkl_001, 1); if (id == -1) { return -1; } asset_handles[43] = id;
        id = CreateBob(&jetpacspritesheet_walkl_002, 1); if (id == -1) { return -1; } asset_handles[44] = id;
        id = CreateBob(&jetpacspritesheet_walkl_003, 1); if (id == -1) { return -1; } asset_handles[45] = id;
        id = CreateBob(&jetpacspritesheet_walkl_004, 1); if (id == -1) { return -1; } asset_handles[46] = id;
        id = CreateBob(&jetpacspritesheet_walkl_005, 1); if (id == -1) { return -1; } asset_handles[47] = id;
        id = CreateBob(&jetpacspritesheet_walkr_000, 1); if (id == -1) { return -1; } asset_handles[48] = id;
        id = CreateBob(&jetpacspritesheet_walkr_001, 1); if (id == -1) { return -1; } asset_handles[49] = id;
        id = CreateBob(&jetpacspritesheet_walkr_002, 1); if (id == -1) { return -1; } asset_handles[50] = id;
        id = CreateBob(&jetpacspritesheet_walkr_003, 1); if (id == -1) { return -1; } asset_handles[51] = id;
        id = CreateBob(&jetpacspritesheet_walkr_004, 1); if (id == -1) { return -1; } asset_handles[52] = id;
        id = CreateBob(&jetpacspritesheet_walkr_005, 1); if (id == -1) { return -1; } asset_handles[53] = id;

        // Standing fire sequence frames (A-screen path uses asset_handles[0..9]).
        id = CreateBob(&jetpacspritesheet_walkfl1, 1); if (id == -1) { return -1; } asset_handles[0] = id;
        id = CreateBob(&jetpacspritesheet_walkfl2, 1); if (id == -1) { return -1; } asset_handles[1] = id;
        id = CreateBob(&jetpacspritesheet_walkfl3, 1); if (id == -1) { return -1; } asset_handles[2] = id;
        id = CreateBob(&jetpacspritesheet_walkfl4, 1); if (id == -1) { return -1; } asset_handles[3] = id;
        id = CreateBob(&jetpacspritesheet_walkfl5, 1); if (id == -1) { return -1; } asset_handles[4] = id;
        id = CreateBob(&jetpacspritesheet_walkfr1, 1); if (id == -1) { return -1; } asset_handles[5] = id;
        id = CreateBob(&jetpacspritesheet_walkfr2, 1); if (id == -1) { return -1; } asset_handles[6] = id;
        id = CreateBob(&jetpacspritesheet_walkfr3, 1); if (id == -1) { return -1; } asset_handles[7] = id;
        id = CreateBob(&jetpacspritesheet_walkfr4, 1); if (id == -1) { return -1; } asset_handles[8] = id;
        id = CreateBob(&jetpacspritesheet_walkfr5, 1); if (id == -1) { return -1; } asset_handles[9] = id;

        player_bob_left = asset_handles[42];
        player_bob_right = asset_handles[48];

        id = CreateBob(&jetpacspritesheet_walkl_000, 1); if (id == -1) { return -1; } walk_left_bobs_b[0] = id;
        id = CreateBob(&jetpacspritesheet_walkl_001, 1); if (id == -1) { return -1; } walk_left_bobs_b[1] = id;
        id = CreateBob(&jetpacspritesheet_walkl_002, 1); if (id == -1) { return -1; } walk_left_bobs_b[2] = id;
        id = CreateBob(&jetpacspritesheet_walkl_003, 1); if (id == -1) { return -1; } walk_left_bobs_b[3] = id;
        id = CreateBob(&jetpacspritesheet_walkl_004, 1); if (id == -1) { return -1; } walk_left_bobs_b[4] = id;
        id = CreateBob(&jetpacspritesheet_walkl_005, 1); if (id == -1) { return -1; } walk_left_bobs_b[5] = id;

        id = CreateBob(&jetpacspritesheet_walkr_000, 1); if (id == -1) { return -1; } walk_right_bobs_b[0] = id;
        id = CreateBob(&jetpacspritesheet_walkr_001, 1); if (id == -1) { return -1; } walk_right_bobs_b[1] = id;
        id = CreateBob(&jetpacspritesheet_walkr_002, 1); if (id == -1) { return -1; } walk_right_bobs_b[2] = id;
        id = CreateBob(&jetpacspritesheet_walkr_003, 1); if (id == -1) { return -1; } walk_right_bobs_b[3] = id;
        id = CreateBob(&jetpacspritesheet_walkr_004, 1); if (id == -1) { return -1; } walk_right_bobs_b[4] = id;
        id = CreateBob(&jetpacspritesheet_walkr_005, 1); if (id == -1) { return -1; } walk_right_bobs_b[5] = id;

        id = CreateBob(&jetpacspritesheet_walkfl1, 1); if (id == -1) { return -1; } fire_stand_left_bobs_b[0] = id;
        id = CreateBob(&jetpacspritesheet_walkfl2, 1); if (id == -1) { return -1; } fire_stand_left_bobs_b[1] = id;
        id = CreateBob(&jetpacspritesheet_walkfl3, 1); if (id == -1) { return -1; } fire_stand_left_bobs_b[2] = id;
        id = CreateBob(&jetpacspritesheet_walkfl4, 1); if (id == -1) { return -1; } fire_stand_left_bobs_b[3] = id;
        id = CreateBob(&jetpacspritesheet_walkfl5, 1); if (id == -1) { return -1; } fire_stand_left_bobs_b[4] = id;

        id = CreateBob(&jetpacspritesheet_walkfr1, 1); if (id == -1) { return -1; } fire_stand_right_bobs_b[0] = id;
        id = CreateBob(&jetpacspritesheet_walkfr2, 1); if (id == -1) { return -1; } fire_stand_right_bobs_b[1] = id;
        id = CreateBob(&jetpacspritesheet_walkfr3, 1); if (id == -1) { return -1; } fire_stand_right_bobs_b[2] = id;
        id = CreateBob(&jetpacspritesheet_walkfr4, 1); if (id == -1) { return -1; } fire_stand_right_bobs_b[3] = id;
        id = CreateBob(&jetpacspritesheet_walkfr5, 1); if (id == -1) { return -1; } fire_stand_right_bobs_b[4] = id;

        player_bob_left_b = walk_left_bobs_b[0];
        player_bob_right_b = walk_right_bobs_b[0];

        id = CreateBob(&jetpacspritesheet_flyl_000, 1); if (id == -1) { return -1; } fly_left_bobs_b[0] = id;
        id = CreateBob(&jetpacspritesheet_flyl_001, 1); if (id == -1) { return -1; } fly_left_bobs_b[1] = id;
        id = CreateBob(&jetpacspritesheet_flyl_002, 1); if (id == -1) { return -1; } fly_left_bobs_b[2] = id;
        id = CreateBob(&jetpacspritesheet_flyl_003, 1); if (id == -1) { return -1; } fly_left_bobs_b[3] = id;
        id = CreateBob(&jetpacspritesheet_flyl_004, 1); if (id == -1) { return -1; } fly_left_bobs_b[4] = id;

        id = CreateBob(&jetpacspritesheet_flyr_000, 1); if (id == -1) { return -1; } fly_right_bobs_b[0] = id;
        id = CreateBob(&jetpacspritesheet_flyr_001, 1); if (id == -1) { return -1; } fly_right_bobs_b[1] = id;
        id = CreateBob(&jetpacspritesheet_flyr_002, 1); if (id == -1) { return -1; } fly_right_bobs_b[2] = id;
        id = CreateBob(&jetpacspritesheet_flyr_003, 1); if (id == -1) { return -1; } fly_right_bobs_b[3] = id;
        id = CreateBob(&jetpacspritesheet_flyr_004, 1); if (id == -1) { return -1; } fly_right_bobs_b[4] = id;

        id = CreateBob(&jetpacspritesheet_flylf_000, 1); if (id == -1) { return -1; } fire_fly_left_bobs_b[0] = id;
        id = CreateBob(&jetpacspritesheet_flylf_001, 1); if (id == -1) { return -1; } fire_fly_left_bobs_b[1] = id;
        id = CreateBob(&jetpacspritesheet_flylf_002, 1); if (id == -1) { return -1; } fire_fly_left_bobs_b[2] = id;
        id = CreateBob(&jetpacspritesheet_flylf_003, 1); if (id == -1) { return -1; } fire_fly_left_bobs_b[3] = id;
        id = CreateBob(&jetpacspritesheet_flylf_004, 1); if (id == -1) { return -1; } fire_fly_left_bobs_b[4] = id;

        id = CreateBob(&jetpacspritesheet_flyrf_000, 1); if (id == -1) { return -1; } fire_fly_right_bobs_b[0] = id;
        id = CreateBob(&jetpacspritesheet_flyrf_001, 1); if (id == -1) { return -1; } fire_fly_right_bobs_b[1] = id;
        id = CreateBob(&jetpacspritesheet_flyrf_002, 1); if (id == -1) { return -1; } fire_fly_right_bobs_b[2] = id;
        id = CreateBob(&jetpacspritesheet_flyrf_003, 1); if (id == -1) { return -1; } fire_fly_right_bobs_b[3] = id;
        id = CreateBob(&jetpacspritesheet_flyrf_004, 1); if (id == -1) { return -1; } fire_fly_right_bobs_b[4] = id;

        // Fire-pose BOBs: one frozen last-frame BOB per direction per screen buffer.
        id = CreateBob(&jetpacspritesheet_flylf_004, 1); if (id == -1) { return -1; } fire_bob_left_a = id;
        id = CreateBob(&jetpacspritesheet_flyrf_004, 1); if (id == -1) { return -1; } fire_bob_right_a = id;
        id = CreateBob(&jetpacspritesheet_flylf_004, 1); if (id == -1) { return -1; } fire_bob_left_b = id;
        id = CreateBob(&jetpacspritesheet_flyrf_004, 1); if (id == -1) { return -1; } fire_bob_right_b = id;

        id = CreateBob(&jetpacspritesheet_rocket, 0); if (id == -1) { return -1; } rocket_bob_a = id;
        id = CreateBob(&jetpacspritesheet_rocket, 0); if (id == -1) { return -1; } rocket_bob_b = id;
        id = CreateBob(&jetpacspritesheet_rocket_top, 1); if (id == -1) { return -1; } rocket_top_bob_a = id;
        id = CreateBob(&jetpacspritesheet_rocket_top, 1); if (id == -1) { return -1; } rocket_top_bob_b = id;
        id = CreateBob(&jetpacspritesheet_rocket_center, 1); if (id == -1) { return -1; } rocket_center_bob_a = id;
        id = CreateBob(&jetpacspritesheet_rocket_center, 1); if (id == -1) { return -1; } rocket_center_bob_b = id;
        id = CreateBob(&jetpacspritesheet_rocket_bottom, 0); if (id == -1) { return -1; } rocket_bottom_bob_a = id;
        id = CreateBob(&jetpacspritesheet_rocket_bottom, 0); if (id == -1) { return -1; } rocket_bottom_bob_b = id;

        // Dead animation frames (deadl_000-004, deadr_000-004) used during player death.
        id = CreateBob(&jetpacspritesheet_deadl_000, 1); if (id == -1) { return -1; } dead_bobs_left[0] = id;
        id = CreateBob(&jetpacspritesheet_deadl_001, 1); if (id == -1) { return -1; } dead_bobs_left[1] = id;
        id = CreateBob(&jetpacspritesheet_deadl_002, 1); if (id == -1) { return -1; } dead_bobs_left[2] = id;
        id = CreateBob(&jetpacspritesheet_deadl_003, 1); if (id == -1) { return -1; } dead_bobs_left[3] = id;
        id = CreateBob(&jetpacspritesheet_deadl_004, 1); if (id == -1) { return -1; } dead_bobs_left[4] = id;
        id = CreateBob(&jetpacspritesheet_deadr_000, 1); if (id == -1) { return -1; } dead_bobs_right[0] = id;
        id = CreateBob(&jetpacspritesheet_deadr_001, 1); if (id == -1) { return -1; } dead_bobs_right[1] = id;
        id = CreateBob(&jetpacspritesheet_deadr_002, 1); if (id == -1) { return -1; } dead_bobs_right[2] = id;
        id = CreateBob(&jetpacspritesheet_deadr_003, 1); if (id == -1) { return -1; } dead_bobs_right[3] = id;
        id = CreateBob(&jetpacspritesheet_deadr_004, 1); if (id == -1) { return -1; } dead_bobs_right[4] = id;

        id = CreateBob(&jetpacspritesheet_fuel, 1); if (id == -1) { return -1; } fuel_bob_a = id;
        id = CreateBob(&jetpacspritesheet_fuel, 1); if (id == -1) { return -1; } fuel_bob_b = id;
        id = CreateBob(&jetpacspritesheet_energy, 1); if (id == -1) { return -1; } energy_bob_a = id;
        id = CreateBob(&jetpacspritesheet_energy, 1); if (id == -1) { return -1; } energy_bob_b = id;

        player_face_right = 1;

        if(load_bob_letters() == -1)
        {
            call DebugLogStr(&dbg_err_load_letters);
            return -1;
        }

        if(load_all_sprites() == -1)
        {
            call DebugLogStr(&dbg_err_sprites);
            return -1;
        }

        pal = GetBobPalette(player_bob_right);
        call LoadPalette(pal, MAX_COLORS);

        if(load_meteor_bobs() == -1)
        {
            call DebugLogStr(&dbg_err_meteor_bobs);
            return -1;
        }
        call load_explosion_bobs();
        if(expl_slots_ready <= 0)
        {
            // Explosions are optional: continue startup without FX slots.
            call DebugLogStr(&dbg_err_expl_bobs);
        }

        return 0;
    }

    proc update_player() -> void {
        var joy:u32;
        var is_walking:byte;
        var fire_btn:u8;
        var new_x:int;
        var new_y:int;
        var x_ok:u8;
        var y_ok:u8;
        var vy:int;
        var was_grounded:byte;
        var now_grounded:byte;
        var landed_this_frame:byte;

        joy = ReadJoystick();

        if(fire_land_cooldown_timer > 0)
        {
            fire_land_cooldown_timer = fire_land_cooldown_timer - 1;
        }

        was_grounded = 0;
        if(CheckPlayerCollision(player_x, player_y + 1) == 0) { was_grounded = 1; }

        new_x = player_x;
        new_y = player_y;

        if(joy & JOY_LEFT)  { new_x = new_x - PLAYER_SPEED; player_face_right = 0; }
        if(joy & JOY_RIGHT) { new_x = new_x + PLAYER_SPEED; player_face_right = 1; }

        // Gravity + jetpack thrust (slow start, fast finish)
        player_thrusting = 0;
        vy = vel_y;
        vy = vy + GRAVITY;
        if(vy > MAX_VEL_DOWN) { vy = MAX_VEL_DOWN; }

        if(joy & JOY_UP)
        {
            player_thrusting = 1;
            vy = vy - THRUST;
            if(vy < -6) { vy = -6; }
        }

        vel_y = vy;
        new_y = new_y + vy;

        // Wrap X, clamp Y before collision check
        if(new_x < 0) { new_x = PLAYER_MAX_X; }
        if(new_x > PLAYER_MAX_X) { new_x = 0; }

        if(new_y < 0) { new_y = 0; vel_y = 0; }
        if(new_y > PLAYER_MAX_Y) { new_y = PLAYER_MAX_Y; vel_y = 0; }

        // Apply each axis only when the new position is tile-clear
        x_ok = CheckPlayerCollision(new_x, player_y);
        if(x_ok != 0) { player_x = new_x; }

        y_ok = CheckPlayerCollision(player_x, new_y);
        if(y_ok != 0) { player_y = new_y; }
        else { vel_y = 0; }

        now_grounded = 0;
        if(CheckPlayerCollision(player_x, player_y + 1) == 0) { now_grounded = 1; }
        landed_this_frame = 0;
        if(was_grounded == 0 && now_grounded != 0) { landed_this_frame = 1; }
        if(landed_this_frame != 0)
        {
            fire_land_cooldown_timer = FIRE_LAND_COOLDOWN_FRAMES;
        }

        is_walking = 0;
        if(joy & JOY_LEFT)  { is_walking = 1; }
        if(joy & JOY_RIGHT) { is_walking = 1; }

        if(is_walking)
        {
            walk_timer = walk_timer + 1;
            if(walk_timer >= WALK_ANIM_RATE)
            {
                walk_timer = 0;
                walk_frame = walk_frame + 1;
                if(walk_frame >= WALK_ANIM_FRAMES) { walk_frame = 0; }
            }
        }
        else
        {
            walk_frame = 0;
            walk_timer = 0;
        }

        if(player_thrusting != 0)
        {
            if(player_jet_sound == 0)
            {
                call PlaySoundEffect(SFX_JET);
                player_jet_sound = 1;
            }

            fly_timer = fly_timer + 1;
            if(fly_timer >= FLY_ANIM_RATE)
            {
                fly_timer = 0;
                fly_frame = fly_frame + 1;
                if(fly_frame >= FLY_ANIM_FRAMES) { fly_frame = 0; }
            }
        }
        else
        {
            fly_frame = 0;
            fly_timer = 0;
            player_jet_sound = 0;
        }

        fire_btn = ReadJoystickFire();
        player_grounded = now_grounded;

        // Fire behaviour:
        // mode 1 = grounded firing, mode 2 = airborne firing.
        // Firing becomes active only once the animation reaches its last frame.
        // Switching grounded/airborne mode cancels firing and restarts the sequence.
        player_firing = 0;
        if(fire_btn == 0)
        {
            player_fire_mode = 0;
            fire_stand_frame = 0;
            fire_stand_timer = 0;
            fire_fly_frame = 0;
            fire_fly_timer = 0;
            player_fire_ready = 0;
            return;
        }

        if(now_grounded != 0)
        {
            if(player_fire_mode != 1)
            {
                player_fire_mode = 1;
                fire_stand_frame = 0;
                fire_stand_timer = 0;
                fire_fly_frame = 0;
                fire_fly_timer = 0;
                player_fire_ready = 0;
            }

            fire_stand_timer = fire_stand_timer + 1;
            if(fire_stand_timer >= FIRE_STAND_ANIM_RATE)
            {
                fire_stand_timer = 0;
                if(fire_stand_frame < (FIRE_STAND_ANIM_FRAMES - 1))
                {
                    fire_stand_frame = fire_stand_frame + 1;
                }
            }

            fire_fly_frame = 0;
            fire_fly_timer = 0;

            if(fire_stand_frame >= (FIRE_STAND_ANIM_FRAMES - 1))
            {
                player_fire_ready = 1;
                player_firing = 1;
            }
            else
            {
                player_fire_ready = 0;
            }
        }
        else
        {
            if(player_fire_mode != 2)
            {
                player_fire_mode = 2;
                fire_fly_frame = 0;
                fire_fly_timer = 0;
                fire_stand_frame = 0;
                fire_stand_timer = 0;
                player_fire_ready = 0;
            }

            fire_fly_timer = fire_fly_timer + 1;
            if(fire_fly_timer >= FIRE_FLY_ANIM_RATE)
            {
                fire_fly_timer = 0;
                if(fire_fly_frame < (FIRE_FLY_ANIM_FRAMES - 1))
                {
                    fire_fly_frame = fire_fly_frame + 1;
                }
            }

            fire_stand_frame = 0;
            fire_stand_timer = 0;

            if(fire_fly_frame >= (FIRE_FLY_ANIM_FRAMES - 1))
            {
                player_fire_ready = 1;
                player_firing = 1;
            }
            else
            {
                player_fire_ready = 0;
            }
        }
    }

    proc add_score(points:int) -> void {
        current_score = current_score + points;
        if(current_score > high_score)
        {
            high_score = current_score;
        }

        if(current_score > highscore_scores[HIGHSCORE_ENTRIES - 1])
        {
            highscore_dirty = 1;
            highscore_needs_insert = 1;
        }

        while(current_score >= bonus_life_next_score)
        {
            if(current_lives < 9)
            {
                current_lives = current_lives + 1;
            }
            bonus_life_next_score = bonus_life_next_score + 500;
        }
    }

    // Up to MAX_BEAMS simultaneous horizontal laser beams, byte-aligned planar writes.
    // Returns 1 if beam slot hit and removed one alien this frame.
    proc laser_hit_alien(beam_slot:int) -> byte {
        var i:int;
        var beam_left:int;
        var beam_right:int;
        var beam_y_pos:int;
        var alien_left:int;
        var alien_right:int;
        var alien_top:int;
        var alien_bottom:int;
        var alien_h:int;
        var lvl:int;
        var add_pts:int;

        beam_left = beam_x[beam_slot];
        beam_right = beam_left + 15;
        beam_y_pos = beam_y[beam_slot];

        for i = 0 to MAX_METEORS - 1
        {
            if(meteor_active[i] == 0) { continue; }

            alien_h = METEOR_BOB_H;
            if(meteor_type[i] == ALIEN_TYPE_UFO_0002) { alien_h = 26; }
            else if(meteor_type[i] == ALIEN_TYPE_UFO_0003) { alien_h = 27; }
            else if(meteor_type[i] == ALIEN_TYPE_UFO_0004) { alien_h = 25; }
            else if(meteor_type[i] == ALIEN_TYPE_UFO_0005) { alien_h = 29; }

            alien_left = meteor_x[i];
            alien_right = alien_left + METEOR_BOB_W_M1;
            alien_top = meteor_y[i];
            alien_bottom = alien_top + alien_h - 1;

            if(beam_right < alien_left) { continue; }
            if(beam_left > alien_right) { continue; }
            if(beam_y_pos < alien_top) { continue; }
            if(beam_y_pos > alien_bottom) { continue; }

            // Hit: despawn alien, spawn explosion and instantly free beam slot.
            call spawn_explosion(meteor_x[i], meteor_y[i]);
            meteor_active[i] = 0;
            meteor_spawn_timer = 0;
            beam_active[beam_slot] = 0;

            lvl = current_level;
            if(lvl < 1) { lvl = 1; }
            if(lvl > MAX_GAME_LEVEL) { lvl = MAX_GAME_LEVEL; }
            add_pts = SCORE_FOR_KILLING * lvl;
            if(add_pts > 50)
            {
                add_pts = 50;
            }
            add_score(add_pts);
            return 1;
        }

        return 0;
    }

    proc update_laser() -> void {
        var i:int;
        var idx:int;
        var found:byte;
        var spawned:byte;
        var spawn_x:int;
        var spawn_y:int;
        var next_x:int;
        var head_x:int;

        if(laser_refill_timer > 0)
        {
            laser_refill_timer = laser_refill_timer - 1;
        }

        // Hold-to-refill fire: while fire is held at ready state, keep spawning
        // into the first free slot until MAX_BEAMS are active.
        if(player_fire_ready != 0)
        {
            if(laser_refill_timer == 0)
            {
                found = 0;
                idx = 0;
                for i = 0 to MAX_BEAMS - 1
                {
                    if(beam_active[i] == 0)
                    {
                        if(found == 0) { idx = i; found = 1; }
                    }
                }

                spawned = 0;
                if(found != 0)
                {
                    if(player_face_right != 0)
                    {
                        spawn_x = player_x + 16;
                        beam_dir[idx] = 1;
                    }
                    else
                    {
                        spawn_x = player_x - 8;
                        beam_dir[idx] = 0;
                    }

                    if(spawn_x < 0) { spawn_x = 0; }
                    if(spawn_x > LASER_MAX_X) { spawn_x = LASER_MAX_X; }
                    spawn_x = (spawn_x >> 3) << 3;

                    spawn_y = player_y + LASER_Y_OFFSET;
                    if(spawn_y < 0) { spawn_y = 0; }
                    if(spawn_y > 255) { spawn_y = 255; }

                    if(beam_dir[idx] != 0) { head_x = spawn_x + 15; }
                    else { head_x = spawn_x; }

                    if(IsPositionWalkable(head_x, spawn_y, 0) != 0)
                    {
                        beam_x[idx] = spawn_x;
                        beam_y[idx] = spawn_y;
                        beam_timer[idx] = LASER_RANGE_STEPS;
                        beam_color_phase[idx] = 0;
                        beam_active[idx] = 1;
                        spawned = 1;
                        call PlaySoundEffect(SFX_LASER);
                    }
                }

                if(spawned != 0)
                {
                    laser_refill_timer = LASER_REFILL_INTERVAL;
                }
            }
        }

        // Advance all active beams.
        for i = 0 to MAX_BEAMS - 1
        {
            if(beam_active[i] == 0) { continue; }

            beam_color_phase[i] = (beam_color_phase[i] + 1) & 3;

            next_x = beam_x[i];
            if(beam_dir[i] != 0)
            {
                next_x = next_x + LASER_SPEED;
                if(next_x > LASER_MAX_X) { beam_active[i] = 0; continue; }
                head_x = next_x + 15;
            }
            else
            {
                next_x = next_x - LASER_SPEED;
                if(next_x < 0) { beam_active[i] = 0; continue; }
                head_x = next_x;
            }

            if(IsPositionWalkable(head_x, beam_y[i], 0) == 0)
            {
                beam_active[i] = 0;
                continue;
            }

            beam_x[i] = next_x;

            if(laser_hit_alien(i) != 0)
            {
                continue;
            }

            if(beam_timer[i] > 0)
            {
                beam_timer[i] = beam_timer[i] - 1;
            }

            if(beam_timer[i] == 0)
            {
                beam_active[i] = 0;
            }
        }
    }

    proc spawn_fuel() -> void {
        var rv:int;

        if(rocket_fuel >= 100) { return; }
        rv = prng_next();
        fuel_x = (((rv >> 3) & 255) % 35) << 3;
        if (fuel_x < 0) { fuel_x = 0; }
        if (fuel_x > PICKUP_MAX_X) { fuel_x = PICKUP_MAX_X; }
        fuel_y = PICKUP_TOP_Y;
        fuel_falling = 1;
        fuel_carried = 0;
        fuel_to_rocket = 0;
        fuel_pickup_lock = 0;
        fuel_active = 1;
        fuel_prev_valid_a = 0;
        fuel_prev_valid_b = 0;
    }


    proc spawn_energy() -> void {
        var rv:int;

        if(energy_active != 0) { return; }
        rv = prng_next();
        energy_x = (((rv >> 11) & 255) % 35) << 3;
        if (energy_x < 0) { energy_x = 0; }
        if (energy_x > PICKUP_MAX_X) { energy_x = PICKUP_MAX_X; }
        energy_y = PICKUP_TOP_Y;
        energy_falling = 1;
        energy_active = 1;
        energy_ttl = ENERGY_VISIBLE_FRAMES;
        energy_prev_valid_a = 0;
        energy_prev_valid_b = 0;
    }


    proc spawn_letters() -> void {
        var t:int;
        var rnd:int;
        var p:letter*;

        letters_active = 0;
        letter_ttl = LETTER_VISIBLE_FRAMES;

        for t=0 to MAX_SPRITES-1
        {
            p = &letter[t];

            p->x = t * 39;
            p->y = t * 25;
            p->active = 1;

            rnd = RndMaxAMOS(3);
            if(rnd == 0)
            {
                rnd = 1;
            }
            p->speedx = rnd;

            rnd = RndMaxAMOS(3);
            if(rnd == 0)
            {
                rnd = 1;
            }
            p->speedy = rnd;
            
            if((t & 1) == 1)
            {
                p->dx = -p->speedx;
            }
            else
            {
                p->dx = p->speedx;
            }

            p->dy = p->speedy;
        }

        ShowSprites();
        for t = 0 to MAX_SPRITES-1
        {
            ShowSprite(t);
        }

        letters_active = 1;
    }

    // Hide all letter sprites and retarget copper to chip null_sprite while
    // sprite DMA stays enabled. Never call HideSprites() here: cutting DMA
    // mid-frame leaves Agnus repeating the last fetched sprite word as a
    // full-screen vertical line.
    proc park_letter_sprites() -> void {
        var i:int;

        letters_active = 0;
        letter_ttl = 0;
        for i = 0 to MAX_SPRITES - 1
        {
            letter[i].active = 0;
            HideSprite(i);
        }
        call UpdateSpritePointers();
    }

    proc update_letters() -> void {
        if(letters_active == 0) { return; }

        if(letter_ttl > 0) { letter_ttl = letter_ttl - 1; }
        if(letter_ttl == 0)
        {
            energy_taken = 0;
            if(letter_caption_mask != LETTER_CAPTION_MASK_END)
            {
                letter_caption_mask = 0;
                letter_caption_drawn_a = 0;
                letter_caption_drawn_b = 0;
            }
            call park_letter_sprites();
        }
    }

    proc draw_letter_caption_on_current_screen(use_b:byte) -> void {
        var i:int;
        var bit:int;
        var x:int;
        var prev_mask:int;
        var draw_mask:int;

        if(use_b != 0) { prev_mask = letter_caption_drawn_b; }
        else { prev_mask = letter_caption_drawn_a; }

        if(letter_caption_mask != 0)
        {
            draw_mask = letter_caption_mask;
            x = LETTER_CAPTION_X;
            bit = 1;
            for i = 0 to 5
            {
                if((prev_mask & bit) != 0 && (draw_mask & bit) == 0)
                {
                    call PasteBackground(asset_letters[i], x, LETTER_CAPTION_Y);
                }
                if((draw_mask & bit) != 0)
                {
                    call GetBobBackground(asset_letters[i], x, LETTER_CAPTION_Y);
                    call PasteBob(asset_letters[i], x, LETTER_CAPTION_Y, 1);
                }
                x = x + TILE_WIDTH;
                bit = bit << 1;
            }
            if(use_b != 0) { letter_caption_valid_b = 1; letter_caption_drawn_b = draw_mask; }
            else { letter_caption_valid_a = 1; letter_caption_drawn_a = draw_mask; }
        }
        else if(use_b != 0 && letter_caption_valid_b != 0)
        {
            x = LETTER_CAPTION_X;
            bit = 1;
            for i = 0 to 5
            {
                if((prev_mask & bit) != 0)
                {
                    call PasteBackground(asset_letters[i], x, LETTER_CAPTION_Y);
                }
                x = x + TILE_WIDTH;
                bit = bit << 1;
            }
            letter_caption_valid_b = 0;
            letter_caption_drawn_b = 0;
        }
        else if(use_b == 0 && letter_caption_valid_a != 0)
        {
            x = LETTER_CAPTION_X;
            bit = 1;
            for i = 0 to 5
            {
                if((prev_mask & bit) != 0)
                {
                    call PasteBackground(asset_letters[i], x, LETTER_CAPTION_Y);
                }
                x = x + TILE_WIDTH;
                bit = bit << 1;
            }
            letter_caption_valid_a = 0;
            letter_caption_drawn_a = 0;
        }
    }

    extern func move_letters() -> void;
    public letters_active;
    public letter;

    interrupt process_letters(0) -> void {
        move_letters();
    }

    proc update_pickups() -> void {
        var rv:int;
        var next_y:int;
        var p_left:int;
        var p_right:int;
        var p_top:int;
        var p_bottom:int;
        var f_left:int;
        var f_right:int;
        var f_top:int;
        var f_bottom:int;

        if (rocket_assembled == 0)
        {
            call update_rocket_assembly();
            return;
        }

        if (fuel_active == 0)
        {
            if (fuel_spawn_timer > 0) { fuel_spawn_timer = fuel_spawn_timer - 1; }
            if (fuel_spawn_timer == 0)
            {
                call spawn_fuel();
                rv = prng_next();
                fuel_spawn_timer = FUEL_SPAWN_DELAY_MIN + ((rv >> 8) & 255) % FUEL_SPAWN_DELAY_RANGE;
            }
        }
        else if (fuel_carried != 0)
        {
            fuel_x = player_x;
            fuel_y = player_y + 16;
            if (fuel_y < 0) { fuel_y = 0; }

            if (player_x == ROCKET_POS_X + 16)
            {
                fuel_carried = 0;
                fuel_to_rocket = 1;
                fuel_x = ROCKET_POS_X + 16;
            }
        }
        else if (fuel_to_rocket != 0)
        {
            next_y = fuel_y + PICKUP_FALL_SPEED;
            if (next_y >= 256 - 32 * 2)
            {
                call PlaySoundEffect(SFX_FUEL_SET);
                fuel_active = 0;
                fuel_to_rocket = 0;
                rocket_fuel = rocket_fuel + FUEL_VOLUME;
                if (rocket_fuel >= 100)
                {
                    rocket_fuel = 100;
                    level_completed = 1;
                }
            }
            else
            {
                fuel_y = next_y;
            }
        }
        else if (fuel_falling != 0)
        {
            next_y = fuel_y + PICKUP_FALL_SPEED;
            if (next_y > 255) { next_y = 255; }
            if (IsPositionWalkable(fuel_x + 2, next_y + 24, 0) != 0 &&
                IsPositionWalkable(fuel_x + 16, next_y + 24, 0) != 0)
            {
                fuel_y = next_y;
            }
            else
            {
                fuel_falling = 0;
                fuel_pickup_lock = 1;
            }
        }

        if (fuel_active != 0 && fuel_falling == 0 && fuel_carried == 0 && fuel_to_rocket == 0)
        {
            p_left = player_x + 13;
            p_right = player_x + PLAYER_BOB_W_M1 - 12;
            p_top = player_y;
            p_bottom = player_y + PLAYER_BOB_H_M1;

            f_left = fuel_x;
            f_right = fuel_x + 15;
            f_top = fuel_y;
            f_bottom = fuel_y + 15;

            if (fuel_pickup_lock == 1)
            {
                if (p_right < f_left || p_left > f_right || p_bottom < f_top || p_top > f_bottom)
                {
                    fuel_pickup_lock = 0;
                }
            }
            else
            {
                if (p_right >= f_left && p_left <= f_right && p_bottom >= f_top && p_top <= f_bottom)
                {
                    fuel_carried = 1; call PlaySoundEffect(SFX_FUEL_PICKUP);
                }
            }
        }

        if (energy_active == 0)
        {
            if (energy_spawn_timer > 0) { energy_spawn_timer--; }
            if (energy_spawn_timer == 0)
            {
                call spawn_energy();
                rv = prng_next();
                energy_spawn_timer = ENERGY_SPAWN_DELAY_MIN + ((rv >> 12) & 255) % ENERGY_SPAWN_DELAY_RANGE;
            }
        }
        else
        {
            if (energy_falling != 0)
            {
                next_y = energy_y + PICKUP_FALL_SPEED;
                if (next_y > 255) { next_y = 255; }
                if (IsPositionWalkable(energy_x + 2, next_y + 24, 0) != 0 &&
                    IsPositionWalkable(energy_x + 16, next_y + 24, 0) != 0)
                {
                    energy_y = next_y;
                }
                else
                {
                    energy_falling = 0;
                }
            }
            else
            {
                p_left = player_x;
                p_right = player_x + PLAYER_BOB_W_M1;
                p_top = player_y;
                p_bottom = player_y + PLAYER_BOB_H_M1;

                f_left = energy_x;
                f_right = energy_x + 15;
                f_top = energy_y;
                f_bottom = energy_y + 15;

                if (p_right >= f_left && p_left <= f_right && p_bottom >= f_top && p_top <= f_bottom)
                {
                    energy_active = 0;
                    if(letters_active == 0 && letter_caption_mask != LETTER_CAPTION_MASK_END)
                    {
                        energy_taken++;
                    }
                    add_score(SCORE_FOR_ENERGY);
                    call PlaySoundEffect(SFX_ENERGY);
                }
            }

            if (energy_ttl > 0) { energy_ttl = energy_ttl - 1; }
            if (energy_ttl == 0)
            {
                energy_active = 0;
            }
        }
    }

    proc update_rocket_assembly() -> void {
        var next_y:int;
        var part_x:int;
        var part_y:int;
        var part_height:int;
        var p_left:int;
        var p_right:int;
        var p_top:int;
        var p_bottom:int;

        if (rocket_part_carried != 0)
        {
            rocket_part_x = player_x;
            rocket_part_y = player_y + 16;
            if (rocket_part_y < 0) { rocket_part_y = 0; }
            if (rocket_part_y > ROCKET_PART_MAX_Y) { rocket_part_y = ROCKET_PART_MAX_Y; }

            if (player_x >= ROCKET_POS_X && player_x <= ROCKET_POS_X + 32)
            {
                rocket_part_carried = 0;
                rocket_part_to_rocket = 1;
                rocket_part_x = ROCKET_POS_X;
            }
            return;
        }

        if (rocket_part_to_rocket != 0)
        {
            next_y = rocket_part_y + PICKUP_FALL_SPEED;
            if (rocket_part_state == 0) { part_y = ROCKET_POS_Y + ROCKET_TOP_HEIGHT; }
            else { part_y = ROCKET_POS_Y; }

            if (next_y >= part_y)
            {
                rocket_part_y = part_y;
                rocket_part_to_rocket = 0;
                rocket_part_state = rocket_part_state + 1;
                call PlaySoundEffect(SFX_FUEL_SET);
                if (rocket_part_state >= 2)
                {
                    rocket_assembled = 1;
                }
            }
            else
            {
                rocket_part_y = next_y;
            }
            return;
        }

        if (rocket_part_state == 0)
        {
            part_x = ROCKET_CENTER_SHELF_X;
            part_y = ROCKET_CENTER_SHELF_Y;
            part_height = ROCKET_CENTER_HEIGHT;
        }
        else
        {
            part_x = ROCKET_TOP_GROUND_X;
            part_y = ROCKET_TOP_GROUND_Y;
            part_height = ROCKET_TOP_HEIGHT;
        }

        p_left = player_x + 13;
        p_right = player_x + PLAYER_BOB_W_M1 - 12;
        p_top = player_y;
        p_bottom = player_y + PLAYER_BOB_H_M1;
        if (p_right >= part_x && p_left <= part_x + 63 && p_bottom >= part_y && p_top <= part_y + part_height - 1)
        {
            rocket_part_carried = 1;
            rocket_part_x = player_x;
            rocket_part_y = player_y + 16;
            rocket_part_clear_state = rocket_part_state;
            rocket_part_source_clear_a = 1;
            rocket_part_source_clear_b = 1;
            call PlaySoundEffect(SFX_FUEL_PICKUP);
        }
    }

    proc erase_rocket_part_on_current_screen(use_b:byte) -> void {
        if (use_b != 0)
        {
            if (rocket_part_prev_valid_b != 0) { call PasteBackground(rocket_part_bob_b, rocket_part_prev_x_b, rocket_part_prev_y_b); }
            rocket_part_prev_valid_b = 0;
        }
        else
        {
            if (rocket_part_prev_valid_a != 0) { call PasteBackground(rocket_part_bob_a, rocket_part_prev_x_a, rocket_part_prev_y_a); }
            rocket_part_prev_valid_a = 0;
        }
    }

    native proc RestoreLevelStrip(__reg(d0) x:int, __reg(d1) y:int, __reg(d2) height:int) -> void {
        asm {
            movem.l d0-d7/a0-a2,-(sp)
            move.l gfx_current_screen_ptr,a0
            move.l #level_screen,a1
            ext.l d1
            mulu.w #200,d1
            adda.l d1,a0
            adda.l d1,a1
            lsr.w #3,d0
            adda.w d0,a0
            adda.w d0,a1
            move.w d2,d7
            subq.w #1,d7
.restore_rocket_part_row:
            move.l (a1),d0
            move.l d0,(a0)
            move.l 4(a1),d0
            move.l d0,4(a0)
            move.l 40(a1),d0
            move.l d0,40(a0)
            move.l 44(a1),d0
            move.l d0,44(a0)
            move.l 80(a1),d0
            move.l d0,80(a0)
            move.l 84(a1),d0
            move.l d0,84(a0)
            move.l 120(a1),d0
            move.l d0,120(a0)
            move.l 124(a1),d0
            move.l d0,124(a0)
            move.l 160(a1),d0
            move.l d0,160(a0)
            move.l 164(a1),d0
            move.l d0,164(a0)
            adda.l #200,a0
            adda.l #200,a1
            dbf d7,.restore_rocket_part_row
            movem.l (sp)+,d0-d7/a0-a2
        }
    }

    proc clear_rocket_part_source_on_current_screen(use_b:byte) -> void {
        if (use_b != 0)
        {
            if (rocket_part_source_clear_b == 0) { return; }
            rocket_part_source_clear_b = 0;
        }
        else
        {
            if (rocket_part_source_clear_a == 0) { return; }
            rocket_part_source_clear_a = 0;
        }

        if (rocket_part_clear_state == 0) { call RestoreLevelStrip(ROCKET_CENTER_SHELF_X, ROCKET_CENTER_SHELF_Y, ROCKET_CENTER_HEIGHT); }
        else { call RestoreLevelStrip(ROCKET_TOP_GROUND_X, ROCKET_TOP_GROUND_Y, ROCKET_TOP_HEIGHT); }
    }

    proc capture_rocket_part_background_on_current_screen(use_b:byte) -> void {
        if (rocket_assembled != 0 || (rocket_part_carried == 0 && rocket_part_to_rocket == 0)) { return; }
        if (rocket_part_state == 0)
        {
            if (use_b != 0) { rocket_part_bob_b = rocket_center_bob_b; }
            else { rocket_part_bob_a = rocket_center_bob_a; }
        }
        else
        {
            if (use_b != 0) { rocket_part_bob_b = rocket_top_bob_b; }
            else { rocket_part_bob_a = rocket_top_bob_a; }
        }
        if (use_b != 0) { call GetBobBackground(rocket_part_bob_b, rocket_part_x, rocket_part_y); }
        else { call GetBobBackground(rocket_part_bob_a, rocket_part_x, rocket_part_y); }
    }

    proc draw_rocket_part_on_current_screen(use_b:byte) -> void {
        if (rocket_assembled != 0 || (rocket_part_carried == 0 && rocket_part_to_rocket == 0)) { return; }
        if (use_b != 0)
        {
            call PasteBob(rocket_part_bob_b, rocket_part_x, rocket_part_y, 1);
            rocket_part_prev_x_b = rocket_part_x;
            rocket_part_prev_y_b = rocket_part_y;
            rocket_part_prev_valid_b = 1;
        }
        else
        {
            call PasteBob(rocket_part_bob_a, rocket_part_x, rocket_part_y, 1);
            rocket_part_prev_x_a = rocket_part_x;
            rocket_part_prev_y_a = rocket_part_y;
            rocket_part_prev_valid_a = 1;
        }
    }

    proc draw_rocket_on_current_screen(use_b:byte, rocket_bob:int) -> void {
        if (rocket_assembled != 0)
        {
            call PasteBob(rocket_bob, ROCKET_POS_X, ROCKET_POS_Y, 1);
            return;
        }

        if (use_b != 0)
        {
            call PasteBob(rocket_bottom_bob_b, ROCKET_POS_X, ROCKET_POS_Y + ROCKET_TOP_HEIGHT + ROCKET_CENTER_HEIGHT, 1);
            if (rocket_part_state >= 1) { call PasteBob(rocket_center_bob_b, ROCKET_POS_X, ROCKET_POS_Y + ROCKET_TOP_HEIGHT, 1); }
            else if (rocket_part_carried == 0 && rocket_part_to_rocket == 0) { call PasteBob(rocket_center_bob_b, ROCKET_CENTER_SHELF_X, ROCKET_CENTER_SHELF_Y, 1); }
            if (rocket_part_state >= 2) { call PasteBob(rocket_top_bob_b, ROCKET_POS_X, ROCKET_POS_Y, 1); }
            else if (rocket_part_state == 0) { call PasteBob(rocket_top_bob_b, ROCKET_TOP_GROUND_X, ROCKET_TOP_GROUND_Y, 1); }
            else if (rocket_part_carried == 0 && rocket_part_to_rocket == 0) { call PasteBob(rocket_top_bob_b, ROCKET_TOP_GROUND_X, ROCKET_TOP_GROUND_Y, 1); }
        }
        else
        {
            call PasteBob(rocket_bottom_bob_a, ROCKET_POS_X, ROCKET_POS_Y + ROCKET_TOP_HEIGHT + ROCKET_CENTER_HEIGHT, 1);
            if (rocket_part_state >= 1) { call PasteBob(rocket_center_bob_a, ROCKET_POS_X, ROCKET_POS_Y + ROCKET_TOP_HEIGHT, 1); }
            else if (rocket_part_carried == 0 && rocket_part_to_rocket == 0) { call PasteBob(rocket_center_bob_a, ROCKET_CENTER_SHELF_X, ROCKET_CENTER_SHELF_Y, 1); }
            if (rocket_part_state >= 2) { call PasteBob(rocket_top_bob_a, ROCKET_POS_X, ROCKET_POS_Y, 1); }
            else if (rocket_part_state == 0) { call PasteBob(rocket_top_bob_a, ROCKET_TOP_GROUND_X, ROCKET_TOP_GROUND_Y, 1); }
            else if (rocket_part_carried == 0 && rocket_part_to_rocket == 0) { call PasteBob(rocket_top_bob_a, ROCKET_TOP_GROUND_X, ROCKET_TOP_GROUND_Y, 1); }
        }
    }

    proc erase_pickups_on_current_screen(use_b:byte) -> void {
        if (use_b != 0)
        {
            if (fuel_prev_valid_b != 0) { call PasteBackground(fuel_bob_b, fuel_prev_x_b, fuel_prev_y_b); }
            fuel_prev_valid_b = 0;

            if (energy_prev_valid_b != 0) { call PasteBackground(energy_bob_b, energy_prev_x_b, energy_prev_y_b); }
            energy_prev_valid_b = 0;
        }
        else
        {
            if (fuel_prev_valid_a != 0) { call PasteBackground(fuel_bob_a, fuel_prev_x_a, fuel_prev_y_a); }
            fuel_prev_valid_a = 0;

            if (energy_prev_valid_a != 0) { call PasteBackground(energy_bob_a, energy_prev_x_a, energy_prev_y_a); }
            energy_prev_valid_a = 0;
        }
    }

    proc capture_pickups_background_on_current_screen(use_b:byte) -> void {
        if (fuel_active != 0)
        {
            if (use_b != 0) { call GetBobBackground(fuel_bob_b, fuel_x, fuel_y); }
            else { call GetBobBackground(fuel_bob_a, fuel_x, fuel_y); }
        }

        if (energy_active != 0)
        {
            if (use_b != 0) { call GetBobBackground(energy_bob_b, energy_x, energy_y); }
            else { call GetBobBackground(energy_bob_a, energy_x, energy_y); }
        }
    }

    proc draw_pickups_on_current_screen(use_b:byte) -> void {
        if (fuel_active != 0)
        {
            if (use_b != 0)
            {
                call PasteBob(fuel_bob_b, fuel_x, fuel_y, 1);
                fuel_prev_x_b = fuel_x;
                fuel_prev_y_b = fuel_y;
                fuel_prev_valid_b = 1;
            }
            else
            {
                call PasteBob(fuel_bob_a, fuel_x, fuel_y, 1);
                fuel_prev_x_a = fuel_x;
                fuel_prev_y_a = fuel_y;
                fuel_prev_valid_a = 1;
            }
        }

        if (energy_active != 0)
        {
            if (use_b != 0)
            {
                call PasteBob(energy_bob_b, energy_x, energy_y, 1);
                energy_prev_x_b = energy_x;
                energy_prev_y_b = energy_y;
                energy_prev_valid_b = 1;
            }
            else
            {
                call PasteBob(energy_bob_a, energy_x, energy_y, 1);
                energy_prev_x_a = energy_x;
                energy_prev_y_a = energy_y;
                energy_prev_valid_a = 1;
            }
        }
    }

    // Erase previous beam pixels for current buffer.
    proc erase_laser_on_current_screen(use_b:byte) -> void {
        var i:int;
        var prev_x:u16;
        var prev_y:u16;
        var prev_valid:int;

        for i = 0 to MAX_BEAMS - 1
        {
            if(use_b != 0)
            {
                prev_x = beam_prev_x_b[i];
                prev_y = beam_prev_y_b[i];
                prev_valid = beam_prev_valid_b[i];
            }
            else
            {
                prev_x = beam_prev_x_a[i];
                prev_y = beam_prev_y_a[i];
                prev_valid = beam_prev_valid_a[i];
            }

            if(prev_valid != 0)
            {
                asm {
                    move.l gfx_current_screen_ptr,a0
                    move.l #level_screen,a1
                    move.w @prev_y,d0
                    ext.l d0
                    mulu.w #200,d0
                    add.l d0,a0
                    add.l d0,a1
                    move.w @prev_x,d1
                    ext.l d1
                    lsr.l #3,d1
                    adda.l d1,a0
                    adda.l d1,a1
                    move.b (a1),(a0)
                    move.b 40(a1),40(a0)
                    move.b 80(a1),80(a0)
                    move.b 120(a1),120(a0)
                    move.b 160(a1),160(a0)
                    move.b 1(a1),1(a0)
                    move.b 41(a1),41(a0)
                    move.b 81(a1),81(a0)
                    move.b 121(a1),121(a0)
                    move.b 161(a1),161(a0)
                }
            }

            if(use_b != 0) { beam_prev_valid_b[i] = 0; }
            else { beam_prev_valid_a[i] = 0; }
        }
    }

    // Draw all active beams for the current buffer.
    proc draw_laser_on_current_screen(use_b:byte) -> void {
        var i:int;
        var cur_x:u16;
        var cur_y:u16;
        var color_idx:int;
        var p0:byte;
        var p1:byte;
        var p2:byte;
        var p3:byte;
        var p4:byte;

        for i = 0 to MAX_BEAMS - 1
        {
            if(beam_active[i] == 0)
            {
                continue;
            }

            color_idx = 31;
            if((beam_color_phase[i] & 3) == 1) { color_idx = 28; }
            if((beam_color_phase[i] & 3) == 2) { color_idx = 24; }
            if((beam_color_phase[i] & 3) == 3) { color_idx = 14; }

            p0 = 0; p1 = 0; p2 = 0; p3 = 0; p4 = 0;
            if(color_idx & 1)  { p0 = 255; }
            if(color_idx & 2)  { p1 = 255; }
            if(color_idx & 4)  { p2 = 255; }
            if(color_idx & 8)  { p3 = 255; }
            if(color_idx & 16) { p4 = 255; }

            cur_x = beam_x[i];
            cur_y = beam_y[i];

            asm {
                move.l gfx_current_screen_ptr,a0
                move.w @cur_y,d0
                ext.l d0
                mulu.w #200,d0
                add.l d0,a0
                move.w @cur_x,d1
                ext.l d1
                lsr.l #3,d1
                adda.l d1,a0
                move.b @p0,(a0)
                move.b @p1,40(a0)
                move.b @p2,80(a0)
                move.b @p3,120(a0)
                move.b @p4,160(a0)
                move.b @p0,1(a0)
                move.b @p1,41(a0)
                move.b @p2,81(a0)
                move.b @p3,121(a0)
                move.b @p4,161(a0)
            }

            if(use_b != 0)
            {
                beam_prev_x_b[i] = cur_x;
                beam_prev_y_b[i] = cur_y;
                beam_prev_valid_b[i] = 1;
            }
            else
            {
                beam_prev_x_a[i] = cur_x;
                beam_prev_y_a[i] = cur_y;
                beam_prev_valid_a[i] = 1;
            }
        }
    }

    // Returns 1 when the 17x31 player box at (px,py) is fully clear of solid tiles.
    // Three rows are probed (top / +TILE_HEIGHT / bottom) so a tile row that falls
    // entirely between the top and bottom corners is never skipped.
    proc CheckPlayerCollision(px:int, py:int) -> u8 {
        if(IsPositionWalkable(px,                   py,                   0) == 0) { return 0; }  // top-left
        if(IsPositionWalkable(px + PLAYER_BOB_W_M1, py,                   0) == 0) { return 0; }  // top-right
        if(IsPositionWalkable(px,                   py + TILE_HEIGHT,     0) == 0) { return 0; }  // mid-left
        if(IsPositionWalkable(px + PLAYER_BOB_W_M1, py + TILE_HEIGHT,     0) == 0) { return 0; }  // mid-right
        if(IsPositionWalkable(px,                   py + PLAYER_BOB_H_M1, 0) == 0) { return 0; }  // bottom-left
        if(IsPositionWalkable(px + PLAYER_BOB_W_M1, py + PLAYER_BOB_H_M1, 0) == 0) { return 0; }  // bottom-right
        return 1;
    }

    proc RefreshLevelBuffersIfDirty() -> void {
        if(level_dirty == 0)
        {
            return;
        }

        call CopyLevelBuffer();
        call SwapScreen();
        call CopyLevelBuffer();
        call SwapScreen();

        level_dirty = 0;
    }

    // Write clamped 4-digit decimal values into fixed zero-padded HUD fields.
    proc hud_write_score(value:int) -> void {
        var i:int;
        var idx:int;
        var q:int;
        var rem:int;
        var v:int;
        var digit:byte;

        v = value;
        if(v > 9999) { v = 9999; }

        for i = 0 to 3
        {
            idx = 3 - i;
            q = v / 10;
            rem = v - (q * 10);
            digit = hud_digit_chars[rem];
            hud_line_text[6 + idx] = digit;
            v = q;
        }
    }

    proc hud_write_high(value:int) -> void {
        var i:int;
        var idx:int;
        var q:int;
        var rem:int;
        var v:int;
        var digit:byte;

        v = value;
        if(v > 9999) { v = 9999; }

        for i = 0 to 3
        {
            idx = 3 - i;
            q = v / 10;
            rem = v - (q * 10);
            digit = hud_digit_chars[rem];
            hud_line_text[29 + idx] = digit;
            v = q;
        }
    }

    proc hud_write_level(value:int) -> void {
        var i:int;
        var idx:int;
        var q:int;
        var rem:int;
        var v:int;
        var digit:byte;

        v = value;
        if(v < 1) { v = 1; }
        if(v > MAX_GAME_LEVEL) { v = MAX_GAME_LEVEL; }

        for i = 0 to 1
        {
            idx = 1 - i;
            q = v / 10;
            q = q & 65535;
            rem = v - (q * 10);
            digit = hud_digit_chars[rem];
            hud_line_text[22 + idx] = digit;
            v = q;
        }
    }

    proc menu_write_high(value:int) -> void {
        var i:int;
        var idx:int;
        var q:int;
        var rem:int;
        var v:int;
        var digit:byte;

        v = value;
        if(v > 9999) { v = 9999; }

        for i = 0 to 3
        {
            idx = 3 - i;
            q = v / 10;
            rem = v - (q * 10);
            digit = hud_digit_chars[rem];
            menu_high_text[12 + idx] = digit;
            v = q;
        }
    }

    proc ladder_write_score_text(value:int) -> void {
        var i:int;
        var idx:int;
        var q:int;
        var rem:int;
        var v:int;
        var digit:byte;

        v = value;
        if(v > 9999) { v = 9999; }

        for i = 0 to 3
        {
            idx = 3 - i;
            q = v / 10;
            rem = v - (q * 10);
            digit = hud_digit_chars[rem];
            ladder_score_text[idx] = digit;
            v = q;
        }
    }

    // Plain repeated ground tile (bottom 8x8 chunks only) across the full menu width.
    native proc draw_menu_ground() -> void {
        asm {
            movem.l d0/d4/d7/a0-a3,-(sp)

            move.l gfx_current_screen_ptr,a0
            adda.l #41600,a0

            moveq #19,d4
.ground_tile:
            move.l d4,d0
            add.l d0,d0
            movea.l a0,a2
            adda.l d0,a2

            ; bottom-left chunk of tileset tile 29 (tileset chunk index 120)
            move.l #jetpack_tileset,a1
            adda.l #4800,a1
            movea.l a2,a3
            moveq #7,d7
.ground_bl:
            move.b (a1)+,d0
            move.b d0,(a3)
            move.b (a1)+,d0
            move.b d0,40(a3)
            move.b (a1)+,d0
            move.b d0,80(a3)
            move.b (a1)+,d0
            move.b d0,120(a3)
            move.b (a1)+,d0
            move.b d0,160(a3)
            adda.l #200,a3
            dbra d7,.ground_bl

            ; bottom-right chunk of tileset tile 29 (tileset chunk index 121)
            move.l #jetpack_tileset,a1
            adda.l #4840,a1
            movea.l a2,a3
            adda.l #1,a3
            moveq #7,d7
.ground_br:
            move.b (a1)+,d0
            move.b d0,(a3)
            move.b (a1)+,d0
            move.b d0,40(a3)
            move.b (a1)+,d0
            move.b d0,80(a3)
            move.b (a1)+,d0
            move.b d0,120(a3)
            move.b (a1)+,d0
            move.b d0,160(a3)
            adda.l #200,a3
            dbra d7,.ground_br

            dbra d4,.ground_tile

            movem.l (sp)+,d0/d4/d7/a0-a3
        }
    }

    proc free_menu_text_bobs() -> void {
        var i:int;
        var handle:int;

        for i = 0 to MENU_TEXT_BOB_COUNT - 1
        {
            handle = menu_text_bobs[i];
            if(handle > 0) { call DestroyBob(handle); }
            menu_text_bobs[i] = 0;
        }
    }

    proc free_text_bobs() -> void {
        call free_menu_text_bobs();
        if(hud_text_bob > 0) { call DestroyBob(hud_text_bob); }
        if(bonus_text_bob > 0) { call DestroyBob(bonus_text_bob); }
        hud_text_bob = 0;
        bonus_text_bob = 0;
    }

    proc draw_menu_text(slot:int, x:int, y:int, string:int, color:int) -> void {
        var handle:int;

        handle = menu_text_bobs[slot];
        if(handle == 0)
        {
            handle = PrintToBob(string, color, 3);
            menu_text_bobs[slot] = handle;
        }
        if(handle > 0)
        {
            call PasteBob(handle, x * 8, y * 8, 1);
        }
        else
        {
            call Text(x, y, string, color);
        }
    }

    proc draw_ladder_screen() -> void {
        var i:int;
        var row:int;
        var base:int;
        var name_ptr:ptr;
        var rank_ptr:int;

        call draw_menu_text(4, 40/2-17/2, 2, &ladder_title_text, HUD_TEXT_COLOR_IDX_3);
        call draw_menu_text(3, 40/2-10/2, 29, &menu_start_text, HUD_TEXT_COLOR_IDX);

        for i = 0 to HIGHSCORE_ENTRIES - 1
        {
            row = 7 + (i * 2);
            rank_ptr = &ladder_rank_10;
            if(i == 0) { rank_ptr = &ladder_rank_01; }
            else if(i == 1) { rank_ptr = &ladder_rank_02; }
            else if(i == 2) { rank_ptr = &ladder_rank_03; }
            else if(i == 3) { rank_ptr = &ladder_rank_04; }
            else if(i == 4) { rank_ptr = &ladder_rank_05; }
            else if(i == 5) { rank_ptr = &ladder_rank_06; }
            else if(i == 6) { rank_ptr = &ladder_rank_07; }
            else if(i == 7) { rank_ptr = &ladder_rank_08; }
            else if(i == 8) { rank_ptr = &ladder_rank_09; }

            call draw_menu_text(5 + i * 3, 5, row, rank_ptr, HUD_TEXT_COLOR_IDX);

            base = i * HIGHSCORE_NAME_STRIDE;
            name_ptr = &highscore_names;
            name_ptr = name_ptr + base;
            call draw_menu_text(6 + i * 3, 10, row, name_ptr, HUD_TEXT_COLOR_IDX_2);

            if(menu_text_bobs[7 + i * 3] <= 0)
            {
                call ladder_write_score_text(highscore_scores[i]);
            }
            call draw_menu_text(7 + i * 3, 28, row, &ladder_score_text, HUD_TEXT_COLOR_IDX);
        }
    }

    proc run_title_menu() -> int {
        var key:byte;
        var fire_btn:u8;
        var screen:int;
        var use_b:byte;
        var rocket_x:int;
        var rocket_y:int;
        var rocket_bob:int;
        var rocket_dx:int;
        var rocket_dy:int;
        var player_bob:int;
        var pl_wait:int = 3;
        var player_x:int;
        var player_dir:int;
        var player_frame:int;
        var i:int;
        var active_count:int;
        var free_slot:int;
        var menu_spawn_timer:int;
        var rv:int;
        var m_x:int;
        var m_y:int;
        var m_dir:int;
        var m_bob:int;
        var menu_view:int;
        var menu_view_timer:int;


        call park_letter_sprites();

        call SwitchMusic(2);

        if(highscore_needs_insert != 0)
        {
            call run_highscore_name_entry(current_score);
            call highscore_insert_new_top(current_score, &highscore_entry_name);
            highscore_needs_insert = 0;
        }
        call menu_write_high(high_score);
        call free_menu_text_bobs();

        screen = 0;
        rocket_x = MENU_ROCKET_START_X;
        rocket_y = MENU_ROCKET_Y;
        rocket_dx = MENU_ROCKET_STEP;
        rocket_dy = 2;
        player_x = 320/2 - 17/2;
        player_dir = 1;
        player_frame = 0;
        player_bob = asset_handles[48];
        use_b = 0;
        menu_spawn_timer = 0;
        menu_view = MENU_VIEW_TITLE;
        menu_view_timer = MENU_TITLE_SHOW_FRAMES;
        energy_taken = 0;

        // Title screen uses first 5 meteor slots for decorative fly-bys.
        for i = 0 to 4
        {
            meteor_active[i] = 0;
            meteor_type[i] = ALIEN_TYPE_METEOR;
            meteor_dir[i] = METEOR_DIR_LEFT;
            meteor_x[i] = 0;
            meteor_y[i] = 0;
        }

        while (1)
        {
            if(cpu_type > 0)
            {
                WaitMs(15);
            }
            key = GetKey();
            if(key == KEY_ESC)
            {
                call free_menu_text_bobs();
                return 0;
            }

            fire_btn = ReadJoystickFire();
            if(fire_btn != 0)
            {
                call free_menu_text_bobs();
                return 1;
            }

            call SwapScreen();
            call ClearScreen();
            call _stars_animate(gfx_current_screen_ptr);

            if(screen == 0)
            {
                rocket_bob = rocket_bob_a;
                use_b = 0;
                if(player_dir > 0)
                {
                    player_bob = asset_handles[48 + player_frame];
                }
                else
                {
                    player_bob = asset_handles[42 + player_frame];
                }
                screen = 1;
            }
            else
            {
                rocket_bob = rocket_bob_b;
                use_b = 1;
                if(player_dir > 0)
                {
                    player_bob = walk_right_bobs_b[player_frame];
                }
                else
                {
                    player_bob = walk_left_bobs_b[player_frame];
                }
                screen = 0;
            }

            if(menu_view == MENU_VIEW_TITLE)
            {
                call draw_menu_ground();
                if(menu_spawn_timer > 0)
                {
                    menu_spawn_timer = menu_spawn_timer - 1;
                }

                active_count = 0;
                free_slot = -1;
                for i = 0 to 4
                {
                    if(meteor_active[i] != 0)
                    {
                        active_count = active_count + 1;
                    }
                    else if(free_slot < 0)
                    {
                        free_slot = i;
                    }
                }

                if(menu_spawn_timer == 0)
                {
                    if(active_count < 5 && free_slot >= 0)
                    {
                        rv = prng_next();

                        if((rv & 256) != 0)
                        {
                            meteor_dir[free_slot] = METEOR_DIR_RIGHT;
                            meteor_x[free_slot] = METEOR_LEFT_START_X;
                        }
                        else
                        {
                            meteor_dir[free_slot] = METEOR_DIR_LEFT;
                            meteor_x[free_slot] = METEOR_START_X;
                        }

                        meteor_type[free_slot] = ALIEN_TYPE_METEOR;
                        meteor_y[free_slot] = 32 + ((rv >> 8) & 127);
                        meteor_active[free_slot] = 1;
                        menu_spawn_timer = 8 + ((rv >> 17) & 31);
                    }
                    else
                    {
                        menu_spawn_timer = 6;
                    }
                }

                for i = 0 to 4
                {
                    if(meteor_active[i] != 0)
                    {
                        m_x = meteor_x[i];
                        m_dir = meteor_dir[i];

                        if(m_dir == METEOR_DIR_RIGHT)
                        {
                            m_x = m_x + METEOR_SPEED + i;
                        }
                        else
                        {
                            m_x = m_x - METEOR_SPEED - i;
                        }

                        if(m_x > METEOR_START_X || m_x < 0)
                        {
                            meteor_active[i] = 0;
                        }
                        else
                        {
                            meteor_x[i] = m_x;
                        }
                    }
                }

                for i = 0 to 4
                {
                    if(meteor_active[i] != 0)
                    {
                        m_x = meteor_x[i];
                        m_y = meteor_y[i];
                        m_dir = meteor_dir[i];

                        if(use_b != 0)
                        {
                            if(m_dir == METEOR_DIR_RIGHT) { m_bob = meteor_bobs_right_b[i]; }
                            else                          { m_bob = meteor_bobs_b[i]; }
                        }
                        else
                        {
                            if(m_dir == METEOR_DIR_RIGHT) { m_bob = meteor_bobs_right_a[i]; }
                            else                          { m_bob = meteor_bobs_a[i]; }
                        }

                        call patch_alien_bob(m_bob, ALIEN_TYPE_METEOR, m_dir);
                        call GetBobBackground(m_bob, m_x, m_y);
                        call PasteBob(m_bob, m_x, m_y, 1);
                    }
                }

                call GetBobBackground(rocket_bob, rocket_x, rocket_y);
                call PasteBob(rocket_bob, rocket_x, rocket_y, 1);
                call GetBobBackground(player_bob, player_x, MENU_PLAYER_Y);
                call PasteBob(player_bob, player_x, MENU_PLAYER_Y, 1);

                call draw_menu_text(0, 13, 1, &menu_high_text, HUD_TEXT_COLOR_IDX_2);
                call draw_menu_text(1, 20-8, 18, &menu_title_text, HUD_TEXT_COLOR_IDX);
                call draw_menu_text(2, 20-7, 20, &author_text, HUD_TEXT_COLOR_IDX);
                call draw_menu_text(3, 40/2-10/2, 22, &menu_start_text, HUD_TEXT_COLOR_IDX);
            }
            else
            {
                call draw_ladder_screen();
            }

            call WaitFrame();
            call Show();

            if(menu_view == MENU_VIEW_TITLE)
            {
                rocket_x = rocket_x + rocket_dx;
                if(rocket_x <= 0)
                {
                    rocket_x = 0;
                    rocket_dx = -rocket_dx;
                }
                else if(rocket_x >= 320 - 64)
                {
                    rocket_x = 320 - 64;
                    rocket_dx = -rocket_dx;
                }

                rocket_y = rocket_y + rocket_dy;
                if(rocket_y <= 0)
                {
                    rocket_y = 0;
                    rocket_dy = -rocket_dy;
                }
                else if(rocket_y >= MENU_GROUND_Y - 121)
                {
                    rocket_y = MENU_GROUND_Y - 121;
                    rocket_dy = -rocket_dy;
                }

                pl_wait = pl_wait - 1;
                if(pl_wait <= 0)
                {
                    pl_wait = 3;
                    player_frame = player_frame + 1;
                    if(player_frame >= WALK_ANIM_FRAMES)
                    {
                        player_frame = 0;
                    }
                }

                player_x = player_x + (player_dir * MENU_PLAYER_STEP);
                if(player_x >= MENU_PLAYER_MAX_X)
                {
                    player_x = MENU_PLAYER_MAX_X;
                    player_dir = -1;
                }
                else if(player_x <= MENU_PLAYER_MIN_X)
                {
                    player_x = MENU_PLAYER_MIN_X;
                    player_dir = 1;
                }
            }

            menu_view_timer = menu_view_timer - 1;
            if(menu_view_timer <= 0)
            {
                if(menu_view == MENU_VIEW_TITLE)
                {
                    menu_view = MENU_VIEW_LADDER;
                    menu_view_timer = MENU_LADDER_SHOW_FRAMES;
                }
                else
                {
                    menu_view = MENU_VIEW_TITLE;
                    menu_view_timer = MENU_TITLE_SHOW_FRAMES;
                }
            }
        }

        return 0;
    }

    proc highscore_entry_name_use_default() -> void {
        var i:int;
        var ch:byte;

        for i = 0 to HIGHSCORE_NAME_STRIDE - 1
        {
            highscore_entry_name[i] = 0;
        }

        for i = 0 to HIGHSCORE_NAME_MAX - 1
        {
            ch = highscore_default_name[i];
            highscore_entry_name[i] = ch;
            if(ch == 0)
            {
                i = HIGHSCORE_NAME_MAX;
            }
        }

        highscore_name_editbox_cursor = 0;
        while(highscore_name_editbox_cursor < HIGHSCORE_NAME_MAX)
        {
            if(highscore_entry_name[highscore_name_editbox_cursor] == 0)
            {
                highscore_name_editbox_cursor = highscore_name_editbox_cursor;
                return;
            }
            highscore_name_editbox_cursor = highscore_name_editbox_cursor + 1;
        }
    }

    proc run_highscore_name_entry(score:int) -> void {
        var key_rv:int;
        var blink_timer:int;
        var cursor_vis:int;

        call highscore_entry_name_use_default();
        highscore_name_editbox_textbuf = &highscore_entry_name;
        highscore_name_editbox_type = GADGET_TYPE_EDITBOX;
        highscore_name_editbox_maxlen = HIGHSCORE_NAME_MAX;
        highscore_name_editbox_flags = 3;

        call ladder_write_score_text(score);

        blink_timer = 0;
        cursor_vis = 1;

        while(1)
        {
            key_rv = EditBoxPollKey(&highscore_entry_name, HIGHSCORE_NAME_MAX, &highscore_name_editbox_cursor);
            if(key_rv == 2 || key_rv == 3)
            {
                if(highscore_entry_name[0] == 0)
                {
                    call highscore_entry_name_use_default();
                }
                return;
            }

            blink_timer = blink_timer + 1;
            if(blink_timer >= 18)
            {
                blink_timer = 0;
                if(cursor_vis != 0)
                {
                    cursor_vis = 0;
                    highscore_name_editbox_flags = 1;
                }
                else
                {
                    cursor_vis = 1;
                    highscore_name_editbox_flags = 3;
                }
            }

            call SwapScreen();
            call ClearScreen();
            call _stars_animate(gfx_current_screen_ptr);
            call draw_menu_text(0, 40/2-7, 8, &highscore_new_title_text, HUD_TEXT_COLOR_IDX);
            call draw_menu_text(1, 40/2-7, 10, &highscore_new_prompt_text, HUD_TEXT_COLOR_IDX);
            call draw_menu_text(2, 40/2-6, 13, &highscore_new_score_label_text, HUD_TEXT_COLOR_IDX);
            call draw_menu_text(3, 40/2+4, 13, &ladder_score_text, HUD_TEXT_COLOR_IDX);
            call DrawGadget(&highscore_name_editbox_x);
            call draw_menu_text(4, 40/2-11, 20, &highscore_new_hint_text, HUD_TEXT_COLOR_IDX);
            call WaitFrame();
            call Show();
        }
    }

    proc highscore_set_name(slot:int, name_ptr:long) -> void {
        var base:int;
        var i:int;
        var ch:byte;

        base = slot * HIGHSCORE_NAME_STRIDE;

        for i = 0 to HIGHSCORE_NAME_STRIDE - 1
        {
            highscore_names[base + i] = 0;
        }

        for i = 0 to HIGHSCORE_NAME_MAX - 1
        {
            ch = peek_b(name_ptr + i);
            if(ch == 0)
            {
                i = HIGHSCORE_NAME_MAX;
            }
            else
            {
                highscore_names[base + i] = ch;
            }
        }

        if(highscore_names[base] == 0)
        {
            call highscore_set_default_name(slot);
        }
    }

    proc highscore_set_default_name(slot:int) -> void {
        var base:int;
        var i:int;

        base = slot * HIGHSCORE_NAME_STRIDE;
        for i = 0 to HIGHSCORE_NAME_STRIDE - 1
        {
            highscore_names[base + i] = highscore_default_name[i];
        }
    }

    proc highscore_reset_defaults() -> void {
        var i:int;

        for i = 0 to HIGHSCORE_ENTRIES - 1
        {
            highscore_scores[i] = 0;
            call highscore_set_default_name(i);
        }
        high_score = 0;
    }

    proc highscore_load_dos() -> int {
        var handle:int;
        var readn:int;
        var pos:int;
        var slot:int;
        var base:int;
        var name_len:int;
        var ch:byte;
        var score:int;

        call highscore_reset_defaults();

        if(FileIoInit() != 0)
        {
            return -1;
        }

        handle = FileOpen(&highscore_file_name, DOS_MODE_OLDFILE);
        if(handle == 0)
        {
            call FileIoDone();
            return -2;
        }

        readn = FileRead(handle, &highscore_io_buffer, HIGHSCORE_FILE_MAX_BYTES - 1);
        call FileClose(handle);
        call FileIoDone();

        if(readn <= 0)
        {
            return -3;
        }

        highscore_io_buffer[readn] = 0;
        pos = 0;
        slot = 0;

        while(slot < HIGHSCORE_ENTRIES)
        {
            ch = highscore_io_buffer[pos];
            while(ch == ASCII_CR || ch == ASCII_NL)
            {
                pos = pos + 1;
                ch = highscore_io_buffer[pos];
            }

            if(ch == 0)
            {
                slot = HIGHSCORE_ENTRIES;
            }
            else
            {
                base = slot * HIGHSCORE_NAME_STRIDE;
                name_len = 0;

                while(ch != 0 && ch != ASCII_COLON && ch != ASCII_CR && ch != ASCII_NL)
                {
                    if(name_len < HIGHSCORE_NAME_MAX)
                    {
                        highscore_names[base + name_len] = ch;
                        name_len = name_len + 1;
                    }
                    pos = pos + 1;
                    ch = highscore_io_buffer[pos];
                }

                highscore_names[base + name_len] = 0;

                if(ch == ASCII_COLON)
                {
                    pos = pos + 1;
                    ch = highscore_io_buffer[pos];
                }

                score = 0;
                while(ch >= ASCII_0 && ch <= 57)
                {
                    score = (score * 10) + (ch - ASCII_0);
                    pos = pos + 1;
                    ch = highscore_io_buffer[pos];
                }

                if(score > HIGHSCORE_MAX_VALUE)
                {
                    score = HIGHSCORE_MAX_VALUE;
                }
                highscore_scores[slot] = score;

                while(ch != 0 && ch != ASCII_NL)
                {
                    pos = pos + 1;
                    ch = highscore_io_buffer[pos];
                }
                if(ch == ASCII_NL)
                {
                    pos = pos + 1;
                }

                slot = slot + 1;
            }
        }

        high_score = highscore_scores[0];
        return 0;
    }

    proc highscore_insert_new_top(score:int, name_ptr:ptr) -> void {
        var i:int;
        var j:int;
        var insert_pos:int;
        var src_base:int;
        var dst_base:int;
        var moved_ch:byte;

        if(score > HIGHSCORE_MAX_VALUE)
        {
            score = HIGHSCORE_MAX_VALUE;
        }

        insert_pos = -1;
        for i = 0 to HIGHSCORE_ENTRIES - 1
        {
            if(score > highscore_scores[i])
            {
                insert_pos = i;
                i = HIGHSCORE_ENTRIES;
            }
        }

        if(insert_pos < 0)
        {
            return;
        }

        i = HIGHSCORE_ENTRIES - 1;
        while(i > insert_pos)
        {
            highscore_scores[i] = highscore_scores[i - 1];

            src_base = (i - 1) * HIGHSCORE_NAME_STRIDE;
            dst_base = i * HIGHSCORE_NAME_STRIDE;
            for j = 0 to HIGHSCORE_NAME_STRIDE - 1
            {
                moved_ch = highscore_names[src_base + j];
                highscore_names[dst_base + j] = moved_ch;
            }

            i = i - 1;
        }

        highscore_scores[insert_pos] = score;
        call highscore_set_name(insert_pos, name_ptr);
        high_score = highscore_scores[0];
    }

    proc highscore_save_dos() -> int {
        var handle:int;
        var wrote:int;
        var pos:int;
        var slot:int;
        var base:int;
        var name_len:int;
        var value:int;
        var q:int;
        var rem:int;
        var digit_idx:int;
        var digit_pos:int;
        var ch:byte;

        if(FileIoInit() != 0)
        {
            return -1;
        }

        pos = 0;
        for slot = 0 to HIGHSCORE_ENTRIES - 1
        {
            base = slot * HIGHSCORE_NAME_STRIDE;
            name_len = 0;
            while(name_len < HIGHSCORE_NAME_MAX)
            {
                ch = highscore_names[base + name_len];
                if(ch != 0)
                {
                    highscore_io_buffer[pos] = ch;
                    pos = pos + 1;
                }
                name_len = name_len + 1;
            }

            highscore_io_buffer[pos] = ASCII_COLON;
            pos = pos + 1;

            value = highscore_scores[slot];
            if(value > HIGHSCORE_MAX_VALUE)
            {
                value = HIGHSCORE_MAX_VALUE;
            }

            digit_pos = pos + 3;
            for digit_idx = 0 to 3
            {
                q = value / 10;
                q = q & 65535;
                rem = value - (q * 10);
                highscore_io_buffer[digit_pos] = ASCII_0 + rem;
                digit_pos = digit_pos - 1;
                value = q;
            }
            pos = pos + 4;

            highscore_io_buffer[pos] = ASCII_NL;
            pos = pos + 1;
        }

        handle = FileOpen(&highscore_file_name, DOS_MODE_NEWFILE);
        if(handle == 0)
        {
            call FileIoDone();
            return -2;
        }

        wrote = FileWrite(handle, &highscore_io_buffer, pos);
        call FileClose(handle);
        call FileIoDone();

        if(wrote != pos)
        {
            return -3;
        }

        return 0;
    }

    proc hud_write_fuel(value:int) -> void {
        var i:int;
        var idx:int;
        var q:int;
        var rem:int;
        var v:int;
        var digit:byte;

        v = value;

        for i = 0 to 2
        {
            idx = 2 - i;
            q = v / 10;
            rem = v - (q * 10);
            digit = hud_digit_chars[rem];
            hud_line_text[36 + idx] = digit;
            v = q;
        }
    }

    // Rebuild HUD only when score/lives/high-score changes (or first forced draw), then mark both
    // buffers dirty so each screen refreshes once on its next render pass.
    proc update_hud_state() -> void {
        var shown_lives:int;
        var lives_digit:byte;
        var hud_changed:byte;

        hud_changed = 0;
        if(current_score != hud_prev_score) { hud_changed = 1; }
        if(high_score != hud_prev_high_score) { hud_changed = 1; }
        if(current_level != hud_prev_level) { hud_changed = 1; }
        if(current_lives != hud_prev_lives) { hud_changed = 1; }
        if(rocket_fuel != hud_prev_fuel) { hud_changed = 1; }
        if(hud_force_redraw != 0) { hud_changed = 1; }
        if(hud_changed != 0)
        {
            call hud_write_score(current_score);
            call hud_write_high(high_score);
            call hud_write_fuel(rocket_fuel);

            shown_lives = current_lives;
            if(shown_lives < 0) { shown_lives = 0; }
            if(shown_lives > 9) { shown_lives = 9; }
            lives_digit = hud_digit_chars[shown_lives];
            hud_line_text[18] = lives_digit;
            call hud_write_level(current_level);

            if(hud_text_bob > 0) { call DestroyBob(hud_text_bob); }
            hud_text_bob = PrintToBob(&hud_line_text, HUD_TEXT_COLOR_IDX, 1);

            hud_prev_score = current_score;
            hud_prev_high_score = high_score;
            hud_prev_level = current_level;
            hud_prev_lives = current_lives;
            hud_prev_fuel = rocket_fuel;
            hud_dirty_a = 1;
            hud_dirty_b = 1;
            hud_force_redraw = 0;
        }
    }

    // Draw HUD text on the active buffer only when that buffer is marked dirty.
    proc draw_hud_on_current_screen(use_b:byte) -> void {
        if(use_b != 0)
        {
            if(hud_dirty_b == 0) { return; }
            hud_dirty_b = 0;
        }
        else
        {
            if(hud_dirty_a == 0) { return; }
            hud_dirty_a = 0;
        }

        // Restore top 8-pixel text strip from static level buffer first,
        // then print HUD so value updates never leave stale glyph pixels.
        asm {
            move.l gfx_current_screen_ptr,a0
            move.l #level_screen,a1
            moveq #8-1,d7
.hud_row_copy:
            moveq #50-1,d6
.hud_row_copy_l:
            move.l (a1)+,(a0)+
            dbf d6,.hud_row_copy_l
            dbf d7,.hud_row_copy
        }

        // Keep HUD on top after all dynamic BOB rendering.
        if(hud_text_bob > 0)
        {
            call PasteBob(hud_text_bob, 0, 0, 1);
        }
        else
        {
            call Text(0, 0, &hud_line_text, HUD_TEXT_COLOR_IDX);
        }
    }

    proc draw_bonus_on_current_screen() -> void {
        if(bonus_active != 0)
        {
            if(bonus_text_bob == 0)
            {
                bonus_text_bob = PrintToBob(&bonus_text, HUD_TEXT_COLOR_IDX, 3);
            }
            if(bonus_text_bob > 0)
            {
                call PasteBob(bonus_text_bob, BONUS_TEXT_X * 8, BONUS_TEXT_Y * 8, 1);
            }
            else
            {
                call Text(BONUS_TEXT_X, BONUS_TEXT_Y, &bonus_text, HUD_TEXT_COLOR_IDX);
            }
        }
    }

    proc update_bonus() -> void {
        if(bonus_active != 0)
        {
            if(bonus_ttl > 0) { bonus_ttl = bonus_ttl - 1; }
            if(bonus_ttl == 0) { bonus_active = 0; }
        }
    }

    proc init_game() -> int {
        var rv:int;
        player_x = 160 - 8;
        player_y = 256-80;

        call DebugSetEnabled(1);
        call DebugClear();

        call HeapInit();
        call InitSound();

        if(SetGraphicsMode(0) == -1)
        {
            call DebugLogStr(&dbg_err_setgfx);
            return -1;
        }

        call SetFont(&fonts);

        if(load_all_assets() == -1)
        {
            call DebugLogStr(&dbg_err_load_assets);
            return -1;
        }

        call CreateMap(current_level);
        call init_meteors();
        call init_explosions();

        fuel_active = 0;
        fuel_falling = 0;
        fuel_carried = 0;
        fuel_to_rocket = 0;
        fuel_pickup_lock = 0;
        fuel_prev_valid_a = 0;
        fuel_prev_valid_b = 0;
        energy_active = 0;
        energy_falling = 0;
        energy_ttl = 0;
        energy_prev_valid_a = 0;
        energy_prev_valid_b = 0;
        rv = prng_next();
        fuel_spawn_timer = FUEL_SPAWN_DELAY_MIN + ((rv >> 5) & 255) % FUEL_SPAWN_DELAY_RANGE;
        rv = prng_next();
        energy_spawn_timer = ENERGY_SPAWN_DELAY_MIN + ((rv >> 9) & 255) % ENERGY_SPAWN_DELAY_RANGE;
        rocket_fuel = 0;
        level_dirty = 1;

        call RefreshLevelBuffersIfDirty();
        call update_hud_state();
        call InitKeyboard();

        return 0;
    }

    // Select current player frame bob handle for buffer A (use_b=0) or B (use_b=1).
    proc select_player_bob_for_buffer(use_b:byte) -> int {
        var draw_bob:int;
        var idx:int;

        if(use_b != 0)
        {
            if(player_fire_mode == 2)
            {
                if(player_face_right == 1) { draw_bob = fire_fly_right_bobs_b[fire_fly_frame]; }
                else { draw_bob = fire_fly_left_bobs_b[fire_fly_frame]; }
            }
            else if(player_fire_mode == 1)
            {
                if(player_face_right == 1) { draw_bob = fire_stand_right_bobs_b[fire_stand_frame]; }
                else { draw_bob = fire_stand_left_bobs_b[fire_stand_frame]; }
            }
            else if(player_grounded == 0)
            {
                if(player_face_right == 1) { draw_bob = fly_right_bobs_b[fly_frame]; }
                else { draw_bob = fly_left_bobs_b[fly_frame]; }
            }
            else
            {
                if(player_face_right == 1) { draw_bob = walk_right_bobs_b[walk_frame]; }
                else { draw_bob = walk_left_bobs_b[walk_frame]; }
            }
        }
        else
        {
            if(player_fire_mode == 2)
            {
                if(player_face_right == 1) { idx = 26 + fire_fly_frame; }
                else { idx = 16 + fire_fly_frame; }
            }
            else if(player_fire_mode == 1)
            {
                if(player_face_right == 1) { idx = 5 + fire_stand_frame; }
                else { idx = 0 + fire_stand_frame; }
            }
            else if(player_grounded == 0)
            {
                if(player_face_right == 1) { idx = 21 + fly_frame; }
                else { idx = 11 + fly_frame; }
            }
            else
            {
                if(player_face_right == 1) { idx = 48 + walk_frame; }
                else { idx = 42 + walk_frame; }
            }
            draw_bob = asset_handles[idx];
        }

        return draw_bob;
    }

    // Draw one gameplay frame on the active back buffer and return the player bob used.
    proc render_gameplay_on_current_screen(use_b:byte, prev_x:int, prev_y:int, prev_bob:int, rocket_bob:int) -> int {
        var draw_bob:int;

        call erase_laser_on_current_screen(use_b);
        call erase_meteors_on_current_screen(use_b);
        call erase_explosions_on_current_screen(use_b);
        call erase_pickups_on_current_screen(use_b);
        call erase_rocket_part_on_current_screen(use_b);
        call PasteBackground(prev_bob, prev_x, prev_y);
        call clear_rocket_part_source_on_current_screen(use_b);
        call RestoreLevelStrip(BONUS_TEXT_X * 8, BONUS_TEXT_Y * 8, 8);
        call RestoreLevelStrip(BONUS_TEXT_X * 8 + 32, BONUS_TEXT_Y * 8, 8);
        call draw_letter_caption_on_current_screen(use_b);

        draw_bob = select_player_bob_for_buffer(use_b);

        call GetBobBackground(draw_bob, player_x, player_y);
        call capture_meteors_background_on_current_screen(use_b);
        call capture_explosions_background_on_current_screen(use_b);
        call capture_pickups_background_on_current_screen(use_b);
        call capture_rocket_part_background_on_current_screen(use_b);
        call PasteBob(draw_bob, player_x, player_y, 1);

        call draw_meteors_on_current_screen(use_b);
        call draw_explosions_on_current_screen(use_b);
        call draw_pickups_on_current_screen(use_b);
        call draw_rocket_part_on_current_screen(use_b);
        call draw_laser_on_current_screen(use_b);
        call draw_rocket_on_current_screen(use_b, rocket_bob);
        call draw_hud_on_current_screen(use_b);
        call draw_bonus_on_current_screen();

        return draw_bob;
    }

    // Rebuild both buffers with map, player and rocket in a consistent state.
    proc prime_level_buffers(player_bob_a:int, player_bob_b:int) -> void {
        call CopyLevelBuffer();
        call GetBobBackground(player_bob_a, player_x, player_y);
        call PasteBob(player_bob_a, player_x, player_y, 1);
        call draw_rocket_on_current_screen(0, rocket_bob_a);
        call draw_hud_on_current_screen(0);
        call SwapScreen();
        call CopyLevelBuffer();
        call GetBobBackground(player_bob_b, player_x, player_y);
        call PasteBob(player_bob_b, player_x, player_y, 1);
        call draw_rocket_on_current_screen(1, rocket_bob_b);
        call draw_hud_on_current_screen(1);
    }

    proc check_letters_start() -> void {
        if(energy_taken == START_LETTERS_WHEN && letters_active == 0 && letter_caption_mask != LETTER_CAPTION_MASK_END)
        {
            energy_taken = 0;
            spawn_letters();
        }        
    }

    proc game_start() -> int {
        var run:bool = 1;
        var screen:int = 1;
        var i:int;
        var rv:int;
        var prev_x_a:int;
        var prev_y_a:int;
        var prev_bob_a:int;
        var prev_x_b:int;
        var prev_y_b:int;
        var prev_bob_b:int;
        var draw_bob:int;

        if(init_game() == -1)
        {
            return -1;
        }

        // Scatter the initial star field on the current video buffer.
        call _stars_init(gfx_current_screen_ptr);
        call SeedRnd(12376);

        if(run_title_menu() == 0)
        {
            return 0;
        }

        current_level = 1;
        current_lives = 3;
        current_score = 0;
        bonus_life_next_score = 500;
        hud_force_redraw = 1;
        call CreateMap(current_level);
        call RefreshLevelBuffersIfDirty();
        call update_hud_state();

        // Prime both buffers with map + player so first shown frame is stable.
        prev_x_a = player_x;
        prev_y_a = player_y;
        prev_bob_a = player_bob_right;
        prev_x_b = player_x;
        prev_y_b = player_y;
        prev_bob_b = player_bob_right_b;
        level_completed = 0;

        call prime_level_buffers(player_bob_right, player_bob_right_b);
        call SwitchMusic(0);

#if F1_DEBUG==1
        var key:byte;
#endif

        starti(0);

        while (run == 1)
        {
            if(letters_active == 1)
            {
                for i = 0 to MAX_SPRITES - 1
                {
                    if(letter[i].active != 0)
                    {
                        SetSpritePosition(i, letter[i].x, letter[i].y);
                    }
                }
            }

            if(cpu_type > 0)
            {
                WaitMs(15);
            }

#if F1_DEBUG==1
            key = GetKey();
            if(key == KEY_F1)
            {
                level_completed = 1;
            }
#endif
            call SwapScreen();
            // Animate stars on the newly active back buffer once per frame.
            call _stars_animate(gfx_current_screen_ptr);
            call update_player();
            call update_laser();
            call update_meteors();
            call check_player_meteor_collision();
            call update_explosions();
            call update_pickups();
            call check_letters_start();
            call update_letters();
            call check_player_letter_collision();
            call update_bonus();
            call update_hud_state();

            if(screen == 0)
            {
                screen = 1;
                draw_bob = render_gameplay_on_current_screen(1, prev_x_b, prev_y_b, prev_bob_b, rocket_bob_b);
                prev_x_b = player_x;
                prev_y_b = player_y;
                prev_bob_b = draw_bob;
            }
            else
            {
                screen = 0;
                draw_bob = render_gameplay_on_current_screen(0, prev_x_a, prev_y_a, prev_bob_a, rocket_bob_a);
                prev_x_a = player_x;
                prev_y_a = player_y;
                prev_bob_a = draw_bob;
            }

            call UpdateSpritePointers();
            call WaitFrame();
            call Show();

            if(level_completed)
            {
                call level_complete();

                player_x = 160 - 8;
                player_y = 256 - 80;
                prev_x_a = player_x;
                prev_y_a = player_y;
                prev_bob_a = player_bob_right;
                prev_x_b = player_x;
                prev_y_b = player_y;
                prev_bob_b = player_bob_right_b;
                if(player_face_right == 0)
                {
                    prev_bob_a = player_bob_left;
                    prev_bob_b = player_bob_left_b;
                }

                screen = 1;

                call prime_level_buffers(prev_bob_a, prev_bob_b);
            }

            if (player_dead != 0)
            {
                call PlaySoundEffect(SFX_PLAYER_DEATH);

                if (player_die() == 1)
                {
                    if(run_title_menu() == 0)
                    {
                        run = 0;
                    }
                    else
                    {
                        current_level = 1;
                        current_lives = 3;
                        current_score = 0;
                        bonus_life_next_score = 500;
                        hud_force_redraw = 1;

                        player_x = 160 - 8;
                        player_y = 256 - 80;
                        vel_y = 0;
                        player_thrusting = 0;
                        player_jet_sound = 0;
                        walk_frame = 0;
                        walk_timer = 0;
                        fly_frame = 0;
                        fly_timer = 0;
                        fire_stand_frame = 0;
                        fire_stand_timer = 0;
                        fire_fly_frame = 0;
                        fire_fly_timer = 0;
                        player_firing = 0;
                        player_fire_mode = 0;
                        player_fire_ready = 0;
                        fire_land_cooldown_timer = 0;
                        player_face_right = 1;
                        player_dead = 0;

                        for i = 0 to MAX_METEORS - 1
                        {
                            meteor_active[i] = 0;
                            meteor_prev_valid_a[i] = 0;
                            meteor_prev_valid_b[i] = 0;
                        }
                        for i = 0 to MAX_EXPLOSIONS - 1
                        {
                            expl_active[i] = 0;
                            expl_prev_valid_a[i] = 0;
                            expl_prev_valid_b[i] = 0;
                        }
                        for i = 0 to MAX_BEAMS - 1
                        {
                            beam_active[i] = 0;
                            beam_prev_valid_a[i] = 0;
                            beam_prev_valid_b[i] = 0;
                        }

                        fuel_active = 0;
                        fuel_falling = 0;
                        fuel_carried = 0;
                        fuel_to_rocket = 0;
                        fuel_pickup_lock = 0;
                        fuel_prev_valid_a = 0;
                        fuel_prev_valid_b = 0;
                        energy_active = 0;
                        energy_falling = 0;
                        energy_ttl = 0;
                        energy_prev_valid_a = 0;
                        energy_prev_valid_b = 0;
                        meteor_spawn_timer = 0;
                        rv = prng_next();
                        fuel_spawn_timer = FUEL_SPAWN_DELAY_MIN + ((rv >> 5) & 255) % FUEL_SPAWN_DELAY_RANGE;
                        rv = prng_next();
                        energy_spawn_timer = ENERGY_SPAWN_DELAY_MIN + ((rv >> 9) & 255) % ENERGY_SPAWN_DELAY_RANGE;
                        rocket_fuel = 0;
                        level_completed = 0;
                        level_dirty = 1;

                        call CreateMap(current_level);
                        call RefreshLevelBuffersIfDirty();
                        call update_hud_state();
                        call _stars_init(gfx_current_screen_ptr);
                        call SwitchMusic(0);

                        prev_x_a = player_x;
                        prev_y_a = player_y;
                        prev_bob_a = player_bob_right;
                        prev_x_b = player_x;
                        prev_y_b = player_y;
                        prev_bob_b = player_bob_right_b;

                        screen = 1;

                        call prime_level_buffers(prev_bob_a, prev_bob_b);
                    }
                }
                else
                {
                    prev_x_a = player_x;
                    prev_y_a = player_y;
                    prev_bob_a = player_bob_right;
                    prev_x_b = player_x;
                    prev_y_b = player_y;
                    prev_bob_b = player_bob_right_b;
                    if (player_face_right == 0)
                    {
                        prev_bob_a = player_bob_left;
                        prev_bob_b = player_bob_left_b;
                    }

                    screen = 1;

                    call prime_level_buffers(prev_bob_a, prev_bob_b);
                }
            }
        }

        QuitSound();
        endi(0);
        return 0;
    }

    // Player-meteor AABB collision check; sets player_dead=1 on first hit.
    proc check_player_meteor_collision() -> void {
        var i:int;
        var p_left:int;
        var p_right:int;
        var p_top:int;
        var p_bottom:int;
        var m_right:int;
        var m_bottom:int;
        var bob_h:int;

        if (player_dead != 0) { return; }

        p_left   = player_x + 10;
        p_right  = player_x + PLAYER_BOB_W_M1 - 10;
        p_top    = player_y;
        p_bottom = player_y + PLAYER_BOB_H_M1;

        for i = 0 to MAX_METEORS - 1
        {
            if (meteor_active[i] == 0) { continue; }

            bob_h = METEOR_BOB_H;
            if (meteor_type[i] == ALIEN_TYPE_UFO_0002) { bob_h = 26; }
            else if (meteor_type[i] == ALIEN_TYPE_UFO_0003) { bob_h = 27; }
            else if (meteor_type[i] == ALIEN_TYPE_UFO_0004) { bob_h = 25; }
            else if (meteor_type[i] == ALIEN_TYPE_UFO_0005) { bob_h = 29; }

            m_right  = meteor_x[i] + METEOR_BOB_W_M1;
            m_bottom = meteor_y[i] + bob_h - 1;

            if (p_right  < meteor_x[i]) { continue; }
            if (p_left   > m_right)     { continue; }
            if (p_bottom < meteor_y[i]) { continue; }
            if (p_top    > m_bottom)    { continue; }

            player_dead = 1;
            return;
        }
    }

    proc check_player_letter_collision() -> void {
        var i:int;
        var p_left:int;
        var p_right:int;
        var p_top:int;
        var p_bottom:int;
        var m_right:int;
        var m_bottom:int;
        var all_caught:int = 1;

        if (player_dead != 0 || letters_active == 0) { return; }

        p_left   = player_x + 10;
        p_right  = player_x + PLAYER_BOB_W_M1 - 10;
        p_top    = player_y;
        p_bottom = player_y + PLAYER_BOB_H_M1;

        for i = 0 to MAX_SPRITES - 1
        {
            if (letter[i].active == 0) { continue; }
            all_caught = 0;

            m_right  = letter[i].x + 16;
            m_bottom = letter[i].y + 16 - 1;

            if (p_right  < letter[i].x) { continue; }
            if (p_left   > m_right)     { continue; }
            if (p_bottom < letter[i].y) { continue; }
            if (p_top    > m_bottom)    { continue; }

            letter[i].active = 0;
            HideSprite(i);
            if(i < 6)
            {
                letter_caption_mask = letter_caption_mask | (1 << i);
            }
            call PlaySoundEffect(SFX_LETTER);

            if(letter_caption_mask == LETTER_CAPTION_MASK_ALL)
            {
                call park_letter_sprites();
                add_score(SCORE_FOR_JETPAC);
                letter_caption_mask = LETTER_CAPTION_MASK_END;
                bonus_active = 1;
                bonus_ttl = BONUS_VISIBLE_FRAMES;
            }

            return;
        }

        if(all_caught == 1)
        {
            call park_letter_sprites();
            if(letter_caption_mask == LETTER_CAPTION_MASK_ALL)
            {
                add_score(SCORE_FOR_JETPAC);
                letter_caption_mask = LETTER_CAPTION_MASK_END;
                bonus_active = 1;
                bonus_ttl = BONUS_VISIBLE_FRAMES;
            }
        }
    }

    // Death sequence: fall to solid, play dead animation for ~3 s, then respawn or
    // call end_game.  Returns 0 = player respawned, 1 = game over.
    proc player_die() -> int {
        var i:int;
        var fall_vy:int;
        var fall_done:byte;
        var new_y:int;
        var stand_bob:int;
        var anim_frame:int;
        var anim_timer:int;
        var anim_bob:int;
        var wait_counter:int;
        var rv:int;

        letter_caption_mask = 0;
        letter_caption_valid_a = 0;
        letter_caption_valid_b = 0;
        letter_caption_drawn_a = 0;
        letter_caption_drawn_b = 0;
        bonus_active = 0;
        bonus_ttl = 0;
        call park_letter_sprites();

        // Clear all active entities.
        for i = 0 to MAX_METEORS - 1
        {
            meteor_active[i] = 0;
            meteor_prev_valid_a[i] = 0;
            meteor_prev_valid_b[i] = 0;
        }
        for i = 0 to MAX_EXPLOSIONS - 1
        {
            expl_active[i] = 0;
            expl_prev_valid_a[i] = 0;
            expl_prev_valid_b[i] = 0;
        }
        for i = 0 to MAX_BEAMS - 1
        {
            beam_active[i] = 0;
            beam_prev_valid_a[i] = 0;
            beam_prev_valid_b[i] = 0;
        }
        fuel_active = 0;
        fuel_prev_valid_a = 0;
        fuel_prev_valid_b = 0;
        energy_active = 0;
        energy_prev_valid_a = 0;
        energy_prev_valid_b = 0;
        energy_taken = 0;

        // If airborne, drop player to the nearest solid surface.
        fall_vy = vel_y;
        if (fall_vy < 0) { fall_vy = 0; }
        fall_done = 0;
        if (CheckPlayerCollision(player_x, player_y + 1) == 0) { fall_done = 1; }
        if (player_y >= PLAYER_MAX_Y) { fall_done = 1; }

        while (fall_done == 0)
        {
            fall_vy = fall_vy + GRAVITY;
            if (fall_vy > MAX_VEL_DOWN) { fall_vy = MAX_VEL_DOWN; }
            new_y = player_y + fall_vy;
            if (new_y > PLAYER_MAX_Y) { new_y = PLAYER_MAX_Y; }
            if (CheckPlayerCollision(player_x, new_y) != 0)
            {
                player_y = new_y;
            }
            else
            {
                fall_done = 1;
            }
            if (player_y >= PLAYER_MAX_Y) { fall_done = 1; }

            if (player_face_right != 0) { stand_bob = asset_handles[48]; }
            else { stand_bob = asset_handles[42]; }

            call SwapScreen();
            call CopyLevelBuffer();
            call PasteBob(stand_bob, player_x, player_y, 1);
            call draw_rocket_on_current_screen(0, rocket_bob_a);
            call WaitFrame();
            call Show();
        }
        vel_y = 0; player_y = player_y + 15;

        // Play looping death animation for DEATH_WAIT_FRAMES ticks (~3 s at 50 Hz).
        anim_frame   = 0;
        anim_timer   = 0;
        wait_counter = 0;

        while (wait_counter < DEATH_WAIT_FRAMES)
        {
            if (player_face_right != 0) { anim_bob = dead_bobs_right[anim_frame]; }
            else { anim_bob = dead_bobs_left[anim_frame]; }

            call SwapScreen();
            call CopyLevelBuffer();
            call PasteBob(anim_bob, player_x, player_y, 1);
            call draw_rocket_on_current_screen(0, rocket_bob_a);
            call WaitFrame();
            call Show();

            anim_timer = anim_timer + 1;
            if (anim_timer >= DEATH_ANIM_RATE)
            {
                anim_timer = 0;
                anim_frame = anim_frame + 1;
                if (anim_frame >= DEATH_ANIM_FRAMES) { anim_frame = DEATH_ANIM_FRAMES-1; }
            }
            wait_counter = wait_counter + 1;
        }

        // Decrement lives.
        if (current_lives > 0) { current_lives = current_lives - 1; }
        player_dead = 0;

        if (current_lives == 0)
        {
            call end_game();
            return 1;
        }

        // Respawn: reset player position and all game-object state.
        player_x = 160 - 8;
        player_y = 256 - 80;
        vel_y = 0;
        player_thrusting = 0;
        player_jet_sound = 0;
        walk_frame = 0;
        walk_timer = 0;
        fly_frame = 0;
        fly_timer = 0;
        fire_stand_frame = 0;
        fire_stand_timer = 0;
        fire_fly_frame = 0;
        fire_fly_timer = 0;
        player_firing = 0;
        player_fire_mode = 0;
        player_fire_ready = 0;
        fire_land_cooldown_timer = 0;
        player_face_right = 1;

        fuel_active = 0;
        fuel_falling = 0;
        fuel_carried = 0;
        fuel_to_rocket = 0;
        fuel_pickup_lock = 0;
        fuel_prev_valid_a = 0;
        fuel_prev_valid_b = 0;
        energy_active = 0;
        energy_falling = 0;
        energy_prev_valid_a = 0;
        energy_prev_valid_b = 0;
        meteor_spawn_timer = 0;

        rv = prng_next();
        fuel_spawn_timer = FUEL_SPAWN_DELAY_MIN + ((rv >> 8) & 255) % FUEL_SPAWN_DELAY_RANGE;
        rv = prng_next();
        energy_spawn_timer = ENERGY_SPAWN_DELAY_MIN + ((rv >> 9) & 255) % ENERGY_SPAWN_DELAY_RANGE;

        call update_hud_state();

        return 0;
    }

    // Called when the player runs out of lives.
    proc end_game() -> void {
        var wait_counter:int;

        game_over_text_bob = PrintToBob(&game_over_text, HUD_TEXT_COLOR_IDX, 3);
        wait_counter = 0;
        while (wait_counter < GAME_OVER_WAIT_FRAMES)
        {
            call SwapScreen();
            call CopyLevelBuffer();
            call draw_rocket_on_current_screen(0, rocket_bob_a);
            if(game_over_text_bob > 0)
            {
                call PasteBob(game_over_text_bob, (20-5) * 8, 22 * 8, 1);
            }
            else
            {
                call Text(20-5, 22, &game_over_text, HUD_TEXT_COLOR_IDX);
            }
            call WaitFrame();
            call Show();
            wait_counter = wait_counter + 1;
        }
        if(game_over_text_bob > 0) { call DestroyBob(game_over_text_bob); }
        game_over_text_bob = 0;
    }

    // Animate the rocket off-screen and back before loading the next stage.
    proc level_complete() -> void {
        var i:int;
        var rocket_y:int;
        var rocket_dir:int;
        var next_level:int;
        var transition_done:byte;

        letter_caption_mask = 0;
        letter_caption_valid_a = 0;
        letter_caption_valid_b = 0;
        letter_caption_drawn_a = 0;
        letter_caption_drawn_b = 0;
        bonus_active = 0;
        call park_letter_sprites();

        for i = 0 to MAX_METEORS - 1
        {
            meteor_active[i] = 0;
            meteor_prev_valid_a[i] = 0;
            meteor_prev_valid_b[i] = 0;
        }

        for i = 0 to MAX_EXPLOSIONS - 1
        {
            expl_active[i] = 0;
            expl_prev_valid_a[i] = 0;
            expl_prev_valid_b[i] = 0;
        }
        
        for i = 0 to MAX_BEAMS - 1
        {
            beam_active[i] = 0;
            beam_prev_valid_a[i] = 0;
            beam_prev_valid_b[i] = 0;
        }

        fuel_active = 0;
        fuel_prev_valid_a = 0;
        fuel_prev_valid_b = 0;
        energy_active = 0;
        energy_prev_valid_a = 0;
        energy_prev_valid_b = 0;
        level_completed = 0;
        energy_taken = 0;

        next_level = current_level + 1;
        if(next_level > MAX_GAME_LEVEL) { next_level = MAX_GAME_LEVEL; }

        call SwitchMusic(1);

        rocket_y = ROCKET_POS_Y;
        rocket_dir = -1;
        transition_done = 0;

        while(transition_done == 0)
        {
            if(cpu_type > 0)
            {
                WaitMs(15);
            }
            call SwapScreen();
            call CopyLevelBuffer();
            call PasteBob(rocket_bob_a, ROCKET_POS_X, rocket_y, 1);
            call WaitFrame();
            call Show();

            if(rocket_dir < 0)
            {
                rocket_y = rocket_y - 2;
                if(rocket_y <= 0)
                {
                    rocket_y = 0;
                    rocket_dir = 1;
                }
            }
            else
            {
                rocket_y = rocket_y + 3;
                if(rocket_y >= ROCKET_POS_Y)
                {
                    rocket_y = ROCKET_POS_Y;
                    transition_done = 1;
                }
            }
        }

        call SwapScreen();
        call CopyLevelBuffer();
        call PasteBob(rocket_bob_a, ROCKET_POS_X, ROCKET_POS_Y, 1);
        call WaitFrame();
        call Show();

        current_level = next_level;
        level_dirty = 1;
        call CreateMap(current_level);
        call RefreshLevelBuffersIfDirty();
        call update_hud_state();

        call SwitchMusic(0);
    }


    // Galois LFSR-based PRNG: advances seed one step and returns new seed in d0.
    // Polynomial feedback: bit 0 drives XOR with $80000057 (bits 31,6,4,2,1,0).
    native proc prng_next() -> int {
        asm {
            move.l  prng_seed,d1       ; load seed into d1
            move.l  d1,d0              ; copy seed to d0
            lsr.l   #1,d0              ; shift right by 1
            and.l   #1,d1              ; isolate bit 0 of original seed
            neg.l   d1                 ; if bit0=1 then d1=0xFFFFFFFF else 0
            and.l   #$80000057,d1      ; mask feedback polynomial
            eor.l   d0,d1              ; XOR shifted seed with mask or zero
            move.l  d1,prng_seed       ; update seed in memory
            move.l  d1,d0              ; return new seed in d0
        }
    }

    // Allocate two BOB handles per meteor slot (one per screen buffer).
    proc load_meteor_bobs() -> int {
        var i:int;
        var id:int;
        for i = 0 to MAX_METEORS - 1
        {
            id = CreateBob(&jetpacspritesheet_ufo_0005, 1);
            if (id == -1) { return -1; }
            meteor_bobs_a[i] = id;

            id = CreateBob(&jetpacspritesheet_ufo_0005, 1);
            if (id == -1) { return -1; }
            meteor_bobs_b[i] = id;

            id = CreateBob(&jetpacspritesheet_ufo_0005, 1);
            if (id == -1) { return -1; }
            meteor_bobs_right_a[i] = id;

            id = CreateBob(&jetpacspritesheet_ufo_0005, 1);
            if (id == -1) { return -1; }
            meteor_bobs_right_b[i] = id;
        }
        return 0;
    }

    // Patch alien BOB runtime struct to the descriptor for the current level type.
    proc patch_alien_bob(bob:int, alien_type:int, dir:int) -> void {
        var desc:int;

        if (alien_type == ALIEN_TYPE_METEOR)
        {
            if (dir == METEOR_DIR_RIGHT) { desc = &jetpacspritesheet_meteorr; }
            else                         { desc = &jetpacspritesheet_meteor; }
        }
        else if (alien_type == ALIEN_TYPE_UFO_0002)
        {
            desc = &jetpacspritesheet_ufo_0002;
        }
        else if (alien_type == ALIEN_TYPE_UFO_0003)
        {
            desc = &jetpacspritesheet_ufo_0003;
        }
        else if (alien_type == ALIEN_TYPE_UFO_0004)
        {
            desc = &jetpacspritesheet_ufo_0004;
        }
        else
        {
            desc = &jetpacspritesheet_ufo_0005;
        }

        asm {
            move.l @bob,a0
            move.l @desc,a1
            move.l (a1),(a0)
            move.l 4(a1),4(a0)
            move.w 14(a1),20(a0)
        }
    }

    // Explosion BOBs are allocated up-front (up to MAX_EXPLOSIONS), but tolerate
    // partial allocation and allow gameplay to continue when no slots are ready.
    proc load_explosion_bobs() -> int {
        var i:int;
        var id_a:int;
        var id_b:int;
        for i = 0 to MAX_EXPLOSIONS - 1
        {
            expl_bobs_a[i] = 0;
            expl_bobs_b[i] = 0;
        }

        // Allocate 2 BOBs per slot (one per screen buffer), using the largest frame
        // (expl_4, 32 rows) to size the background save buffer.  Before each
        // GetBobBackground / PasteBob call, patch_expl_bob() rewrites data_ptr,
        // mask_ptr and height in the runtime struct for the current animation frame.
        expl_slots_ready = 0;
        for i = 0 to MAX_EXPLOSIONS - 1
        {
            id_a = CreateBob(&jetpacspritesheet_expl_4, 1);
            if (id_a == -1)
            {
                call DebugLogStr(&dbg_err_expl_alloc_a);
                call DebugLogInt(i);
                break;
            }

            id_b = CreateBob(&jetpacspritesheet_expl_4, 1);
            if (id_b == -1)
            {
                call DebugLogStr(&dbg_err_expl_alloc_b);
                call DebugLogInt(i);
                call DestroyBob(id_a);
                break;
            }

            expl_bobs_a[i] = id_a;
            expl_bobs_b[i] = id_b;
            expl_slots_ready = expl_slots_ready + 1;
        }

        return 0;
    }

    // Ensure one slot has its BOBs allocated.
    proc ensure_explosion_slot_bobs(slot:int) -> byte {
        if (slot < expl_slots_ready) { return 1; }
        return 0;
    }

    // Clear all meteor slots and reset the spawn timer.
    proc init_meteors() -> void {
        var i:int;
        for i = 0 to MAX_METEORS - 1
        {
            meteor_active[i] = 0;
            meteor_type[i] = ALIEN_TYPE_METEOR;
            meteor_dir[i] = METEOR_DIR_LEFT;
            meteor_vdir[i] = UFO_VDIR_DOWN;
            meteor_vtimer[i] = 0;
            meteor_prev_valid_a[i] = 0;
            meteor_prev_valid_b[i] = 0;
            meteor_prev_dir_a[i] = METEOR_DIR_LEFT;
            meteor_prev_dir_b[i] = METEOR_DIR_LEFT;
        }
        meteor_spawn_timer = 0;
    }

    proc init_explosions() -> void {
        var i:int;
        for i = 0 to MAX_EXPLOSIONS - 1
        {
            expl_active[i] = 0;
            expl_frame[i] = 0;
            expl_timer[i] = 0;
            expl_prev_valid_a[i] = 0;
            expl_prev_valid_b[i] = 0;
        }
    }

    // Spawns only when a fully-clean slot exists (both buffers already erased).
    proc spawn_explosion(x:int, y:int) -> void {
        var i:int;

        if (expl_slots_ready <= 0) { return; }
        if (y < 20) { return; }  // don't spawn explosions in HUD area

        for i = 0 to MAX_EXPLOSIONS - 1
        {
            if (expl_active[i] != 0) { continue; }
            if (expl_prev_valid_a[i] != 0) { continue; }
            if (expl_prev_valid_b[i] != 0) { continue; }
            if (ensure_explosion_slot_bobs(i) == 0) { continue; }

            expl_x[i] = x;
            expl_y[i] = y;
            expl_frame[i] = 0;
            expl_timer[i] = 0;
            expl_prev_x_a[i] = -1;
            expl_prev_y_a[i] = -1;
            expl_prev_valid_a[i] = 0;
            expl_prev_x_b[i] = -1;
            expl_prev_y_b[i] = -1;
            expl_prev_valid_b[i] = 0;
            expl_active[i] = 1;

            call PlaySoundEffect(SFX_EXPLOSION);
            return;
        }
    }

    // One-shot explosion sequence: expl_1 -> expl_4, then deactivate.
    proc update_explosions() -> void {
        var i:int;
        for i = 0 to MAX_EXPLOSIONS - 1
        {
            if (expl_active[i] == 0) { continue; }

            expl_timer[i] = expl_timer[i] + 1;
            if (expl_timer[i] >= EXPLOSION_ANIM_RATE)
            {
                expl_timer[i] = 0;
                expl_frame[i] = expl_frame[i] + 1;
                if (expl_frame[i] >= EXPLOSION_ANIM_FRAMES)
                {
                    expl_active[i] = 0;
                }
            }
        }
    }

    // Spawn and move meteors each frame.
    // ALIEN_TYPE_METEOR (0): horizontal, constant speed, both directions.
    // Other types can be dispatched here when alien_type != 0.
    proc update_meteors() -> void {
        var i:int;
        var count:int;
        var found:byte;
        var idx:int;
        var stage:int;
        var alien_type:int;
        var rand_y:int;
        var rv:int;
        var next_x:int;
        var next_y:int;
        var probe_x:int;
        var probe_y:int;
        var probe_y_top:int;
        var probe_y_mid:int;
        var probe_y_bot:int;
        var bob_h:int;
        var solid_hit:byte;

        if (meteor_spawn_timer > 0) { meteor_spawn_timer = meteor_spawn_timer - 1; }

        stage = current_level;
        if (stage < 1) { stage = 1; }
        if (stage > MAX_GAME_LEVEL) { stage = MAX_GAME_LEVEL; }
        stage = ((stage - 1) % MAX_LEVELS) + 1;

        // Count active meteors and record the first fully-clean free slot.
        // A slot is only safe to reuse once both screen buffers have erased
        // the previous meteor image (both prev_valid flags must be 0).
        count = 0;
        found = 0;
        idx = 0;
        for i = 0 to MAX_METEORS - 1
        {
            if (meteor_active[i] != 0)
            {
                count = count + 1;
            }
            else
            {
                if (found == 0)
                {
                    if (meteor_prev_valid_a[i] == 0)
                    {
                        if (meteor_prev_valid_b[i] == 0)
                        {
                            idx = i;
                            found = 1;
                        }
                    }
                }
            }
        }

        // Spawn one new meteor when the timer fires and a slot is free
        if (meteor_spawn_timer == 0)
        {
            if (count < MAX_METEORS)
            {
                if (found != 0)
                {
                    rv = prng_next();
                    rand_y = METEOR_MIN_Y + ((rv & 255) % METEOR_SPAWN_Y_RANGE);
                    if ((rv & 256) != 0)
                    {
                        meteor_dir[idx] = METEOR_DIR_RIGHT;
                        meteor_x[idx] = METEOR_LEFT_START_X;
                    }
                    else
                    {
                        meteor_dir[idx] = METEOR_DIR_LEFT;
                        meteor_x[idx] = METEOR_START_X;
                    }
                    meteor_y[idx] = rand_y;
                    meteor_type[idx] = stage - 1;
                    meteor_vdir[idx] = UFO_VDIR_DOWN;
                    if ((rv & 512) != 0) { meteor_vdir[idx] = UFO_VDIR_UP; }
                    meteor_vtimer[idx] = 8 + ((rv >> 10) & 7);
                    meteor_prev_x_a[idx] = -1;
                    meteor_prev_y_a[idx] = -1;
                    meteor_prev_valid_a[idx] = 0;
                    meteor_prev_dir_a[idx] = meteor_dir[idx];
                    meteor_prev_x_b[idx] = -1;
                    meteor_prev_y_b[idx] = -1;
                    meteor_prev_valid_b[idx] = 0;
                    meteor_prev_dir_b[idx] = meteor_dir[idx];
                    meteor_active[idx] = 1;
                    meteor_spawn_timer = METEOR_SPAWN_DELAY;
                }
            }
        }

        // Move all active meteors
        for i = 0 to MAX_METEORS - 1
        {
            if (meteor_active[i] == 0) { continue; }

            alien_type = meteor_type[i];
            bob_h = METEOR_BOB_H;
            if (alien_type == ALIEN_TYPE_UFO_0002) { bob_h = 26; }
            else if (alien_type == ALIEN_TYPE_UFO_0003) { bob_h = 27; }
            else if (alien_type == ALIEN_TYPE_UFO_0004) { bob_h = 25; }
            else if (alien_type == ALIEN_TYPE_UFO_0005) { bob_h = 29; }

            next_x = meteor_x[i];
            next_y = meteor_y[i];
            solid_hit = 0;

            if (meteor_dir[i] == METEOR_DIR_RIGHT) 
            { 
                next_x = next_x + 1 + (next_y & 3); probe_x = next_x + METEOR_BOB_W_M1;
            }
            else                                    
            { 
                next_x = next_x - 1 - (next_y & 3); probe_x = next_x;
            }

            if (alien_type == ALIEN_TYPE_METEOR)
            {
                if (next_x > METEOR_START_X || next_x < 0)
                {
                    meteor_active[i] = 0;
                    meteor_spawn_timer = 0;
                    continue;
                }

                if((i & 1) == 1)
                {
                    next_y++;
                }
                else if((i & 3) != 0)
                {
                    next_y--;
                }

                probe_y_top = next_y + 1;
                probe_y_mid = next_y + (bob_h >> 1);
                probe_y_bot = next_y + bob_h - 1;

                if (IsPositionWalkable(probe_x, probe_y_top, 0) == 0 ||
                    IsPositionWalkable(probe_x, probe_y_mid, 0) == 0 ||
                    IsPositionWalkable(probe_x, probe_y_bot, 0) == 0)
                {
                    call spawn_explosion(next_x, next_y);
                    meteor_active[i] = 0;
                    meteor_spawn_timer = 0;
                    continue;
                }

                meteor_x[i] = next_x;
                meteor_y[i] = next_y;
            }
            else if (alien_type == ALIEN_TYPE_UFO_0002)
            {
                if (meteor_vdir[i] == UFO_VDIR_DOWN) { next_y = next_y + UFO_VERT_SPEED + (i & 1); }
                else                                  { next_y = next_y - UFO_VERT_SPEED - (i & 1); }

                if (next_x > METEOR_START_X || next_x < 0)
                {
                    meteor_active[i] = 0;
                    meteor_spawn_timer = 0;
                    continue;
                }

                if (next_y <= METEOR_MIN_Y)
                {
                    next_y = METEOR_MIN_Y;
                    meteor_vdir[i] = UFO_VDIR_DOWN;
                }
                else if (next_y >= METEOR_MAX_Y)
                {
                    next_y = METEOR_MAX_Y;
                    meteor_vdir[i] = UFO_VDIR_UP;
                }

                probe_y_top = next_y + 1;
                probe_y_mid = next_y + (bob_h >> 1);
                probe_y_bot = next_y + bob_h - 1;

                if (IsPositionWalkable(probe_x, probe_y_top, 0) == 0 ||
                    IsPositionWalkable(probe_x, probe_y_mid, 0) == 0 ||
                    IsPositionWalkable(probe_x, probe_y_bot, 0) == 0)
                {
                    call spawn_explosion(next_x, next_y);
                    meteor_active[i] = 0;
                    meteor_spawn_timer = 0;
                    continue;
                }

                probe_y = next_y;
                if (meteor_vdir[i] == UFO_VDIR_DOWN) { probe_y = next_y + bob_h - 1; }
                if (IsPositionWalkable(next_x + (METEOR_BOB_W >> 1), probe_y, 0) == 0)
                {
                    call spawn_explosion(next_x, next_y);
                    meteor_active[i] = 0;
                    meteor_spawn_timer = 0;
                    continue;
                }

                meteor_x[i] = next_x;
                meteor_y[i] = next_y;
            }
            else if (alien_type == ALIEN_TYPE_UFO_0003)
            {
                if (meteor_vdir[i] == UFO_VDIR_DOWN) { next_y = next_y + UFO_VERT_SPEED + (i & 1); }
                else                                  { next_y = next_y - UFO_VERT_SPEED - (i & 1); }

                if(next_x > METEOR_START_X)
                {
                    next_x = METEOR_START_X;
                    meteor_dir[i] = METEOR_DIR_LEFT;
                    continue;
                }
                else if(next_x < 0)
                {
                    next_x = 0;
                    meteor_dir[i] = METEOR_DIR_RIGHT;
                    continue;
                }

                if (next_y <= METEOR_MIN_Y)
                {
                    next_y = METEOR_MIN_Y;
                    meteor_vdir[i] = UFO_VDIR_DOWN;
                }
                else if (next_y >= METEOR_MAX_Y)
                {
                    next_y = METEOR_MAX_Y;
                    meteor_vdir[i] = UFO_VDIR_UP;
                }

                probe_y_top = next_y + 1;
                probe_y_mid = next_y + (bob_h >> 1);
                probe_y_bot = next_y + bob_h - 1;

                if (IsPositionWalkable(probe_x, probe_y_top, 0) == 0 ||
                    IsPositionWalkable(probe_x, probe_y_mid, 0) == 0 ||
                    IsPositionWalkable(probe_x, probe_y_bot, 0) == 0)
                {
                    solid_hit = 1;
                }

                probe_y = next_y;
                if (meteor_vdir[i] == UFO_VDIR_DOWN) { probe_y = next_y + bob_h - 1; }
                if (IsPositionWalkable(next_x + (METEOR_BOB_W >> 1), probe_y, 0) == 0)
                {
                    if (meteor_vdir[i] == UFO_VDIR_DOWN) { meteor_vdir[i] = UFO_VDIR_UP; }
                    else                                  { meteor_vdir[i] = UFO_VDIR_DOWN; }
                    next_y = meteor_y[i];
                }

                if (solid_hit != 0)
                {
                    if (meteor_dir[i] == METEOR_DIR_RIGHT) { meteor_dir[i] = METEOR_DIR_LEFT; }
                    else                                    { meteor_dir[i] = METEOR_DIR_RIGHT; }
                }
                else
                {
                    meteor_x[i] = next_x;
                }

                meteor_y[i] = next_y;
            }
            else if (alien_type == ALIEN_TYPE_UFO_0004)
            {
                next_x = meteor_x[i];
                next_y = meteor_y[i];

                if (player_x > meteor_x[i])
                {
                    next_x = next_x + METEOR_SPEED;
                    meteor_dir[i] = METEOR_DIR_RIGHT;
                }
                else if (player_x < meteor_x[i])
                {
                    next_x = next_x - METEOR_SPEED;
                    meteor_dir[i] = METEOR_DIR_LEFT;
                }

                if (player_y > meteor_y[i]) { next_y = next_y + UFO_VERT_SPEED + (i & 1); }
                else if (player_y < meteor_y[i]) { next_y = next_y - UFO_VERT_SPEED - (i & 1); }

                if (next_x > METEOR_START_X || next_x < 0)
                {
                    meteor_active[i] = 0;
                    meteor_spawn_timer = 0;
                    continue;
                }

                if (next_y <= METEOR_MIN_Y) { next_y = METEOR_MIN_Y; }
                if (next_y >= METEOR_MAX_Y) { next_y = METEOR_MAX_Y; }

                if (meteor_dir[i] == METEOR_DIR_RIGHT) { probe_x = next_x + METEOR_BOB_W_M1; }
                else                                    { probe_x = next_x; }
                probe_y_top = next_y + 1;
                probe_y_mid = next_y + (bob_h >> 1);
                probe_y_bot = next_y + bob_h - 1;

                if (IsPositionWalkable(probe_x, probe_y_top, 0) == 0 ||
                    IsPositionWalkable(probe_x, probe_y_mid, 0) == 0 ||
                    IsPositionWalkable(probe_x, probe_y_bot, 0) == 0)
                {
                    call spawn_explosion(next_x, next_y);
                    meteor_active[i] = 0;
                    meteor_spawn_timer = 0;
                    continue;
                }

                probe_y = next_y;
                if (player_y >= meteor_y[i]) { probe_y = next_y + bob_h - 1; }
                if (IsPositionWalkable(next_x + (METEOR_BOB_W >> 1), probe_y, 0) == 0)
                {
                    call spawn_explosion(next_x, next_y);
                    meteor_active[i] = 0;
                    meteor_spawn_timer = 0;
                    continue;
                }

                meteor_x[i] = next_x;
                meteor_y[i] = next_y;
            }
            else
            {
                if (meteor_vtimer[i] > 0) { meteor_vtimer[i] = meteor_vtimer[i] - 1; }
                if (meteor_vtimer[i] == 0)
                {
                    rv = prng_next();
                    if ((rv & 256) != 0)
                    {
                        if (meteor_dir[i] == METEOR_DIR_RIGHT) { meteor_dir[i] = METEOR_DIR_LEFT; }
                        else                                    { meteor_dir[i] = METEOR_DIR_RIGHT; }
                    }
                    if ((rv & 512) != 0) { meteor_vdir[i] = UFO_VDIR_UP; }
                    else                 { meteor_vdir[i] = UFO_VDIR_DOWN; }
                    meteor_vtimer[i] = 6 + ((rv >> 10) & 15);
                }

                if (meteor_vdir[i] == UFO_VDIR_DOWN) { next_y = next_y + UFO_VERT_SPEED + (i & 1); }
                else                                  { next_y = next_y - UFO_VERT_SPEED - (i & 1); }

                if (next_y <= METEOR_MIN_Y)
                {
                    next_y = METEOR_MIN_Y;
                    meteor_vdir[i] = UFO_VDIR_DOWN;
                }
                else if (next_y >= METEOR_MAX_Y)
                {
                    next_y = METEOR_MAX_Y;
                    meteor_vdir[i] = UFO_VDIR_UP;
                }

                meteor_x[i] = next_x;
                meteor_y[i] = next_y;
            }

            // Destroy when leading edge crosses the screen wall.
            // Reset spawn timer so replacement appears right after erase cycle.
            if (meteor_dir[i] == METEOR_DIR_RIGHT)
            {
                if (meteor_x[i] > METEOR_START_X)
                {
                    meteor_active[i] = 0;
                    meteor_spawn_timer = 0;
                }
            }
            else
            {
                if (meteor_x[i] < 0)
                {
                    meteor_active[i] = 0;
                    meteor_spawn_timer = 0;
                }
            }
        }
    }

    // Patches a BOB runtime struct to display the given explosion frame (0..3).
    // Call this before GetBobBackground and PasteBob for the current frame.
    // Do NOT call before PasteBackground — the stored height must match the capture.
    //
    // BOB runtime struct layout (from bob.s):
    //   +0:  data_ptr  (long)
    //   +4:  mask_ptr  (long)
    //   +8:  bg_ptr    (long)
    //   +12: palette_ptr (long)
    //   +16: has_background_flag (word)
    //   +18: width     (word)
    //   +20: height    (word)
    //
    // BOB descriptor layout (&jetpacspritesheet_expl_N):
    //   +0:  data_ptr  (long)
    //   +4:  mask_ptr  (long)
    //   +8:  palette_ptr (long)
    //   +12: width     (word)
    //   +14: height    (word)
    //   +16: color_count (word)
    proc patch_expl_bob(bob:int, frame:int) -> void {
        var desc:int;
        if (frame == 0)      { desc = &jetpacspritesheet_expl_1; }
        else if (frame == 1) { desc = &jetpacspritesheet_expl_2; }
        else if (frame == 2) { desc = &jetpacspritesheet_expl_3; }
        else                 { desc = &jetpacspritesheet_expl_4; }
        asm {
            move.l @bob,a0           ; a0 = BOB runtime struct
            move.l @desc,a1          ; a1 = frame descriptor
            move.l (a1),(a0)         ; patch data_ptr  at +0
            move.l 4(a1),4(a0)      ; patch mask_ptr  at +4
            move.w 14(a1),20(a0)    ; patch height    at +20 (descriptor +14 -> struct +20)
        }
    }

    // Erase previous explosion BOBs for current buffer.
    proc erase_explosions_on_current_screen(use_b:byte) -> void {
        var i:int;
        var bob:int;
        var prev_x:u16;
        var prev_y:u16;
        var prev_valid:int;

        for i = 0 to MAX_EXPLOSIONS - 1
        {
            if (use_b != 0)
            {
                bob = expl_bobs_b[i];
                prev_x = expl_prev_x_b[i];
                prev_y = expl_prev_y_b[i];
                prev_valid = expl_prev_valid_b[i];
            }
            else
            {
                bob = expl_bobs_a[i];
                prev_x = expl_prev_x_a[i];
                prev_y = expl_prev_y_a[i];
                prev_valid = expl_prev_valid_a[i];
            }

            if (prev_valid != 0)
            {
                call PasteBackground(bob, prev_x, prev_y);
            }

            if (use_b != 0) { expl_prev_valid_b[i] = 0; }
            else { expl_prev_valid_a[i] = 0; }
        }
    }

    // Capture background for current explosion frame before dynamic draw.
    proc capture_explosions_background_on_current_screen(use_b:byte) -> void {
        var i:int;
        var bob:int;
        var cur_x:int;
        var cur_y:int;
        var frame:int;

        for i = 0 to MAX_EXPLOSIONS - 1
        {
            if (expl_active[i] == 0) { continue; }

            cur_x = expl_x[i];
            cur_y = expl_y[i];
            if (cur_x < 0 || cur_x > EXPLOSION_MAX_X) { continue; }
            if (cur_y < 16 || cur_y > EXPLOSION_MAX_Y) { continue; }

            frame = expl_frame[i];
            if (use_b != 0) { bob = expl_bobs_b[i]; }
            else            { bob = expl_bobs_a[i]; }

            call patch_expl_bob(bob, frame);
            call GetBobBackground(bob, cur_x, cur_y);
        }
    }

    // Draw active explosions and remember position for next-buffer erase.
    // patch_expl_bob() was already called in capture; runtime struct height
    // is correct for the current frame — PasteBob draws it immediately.
    proc draw_explosions_on_current_screen(use_b:byte) -> void {
        var i:int;
        var bob:int;
        var cur_x:int;
        var cur_y:int;

        for i = 0 to MAX_EXPLOSIONS - 1
        {
            if (expl_active[i] == 0) { continue; }

            cur_x = expl_x[i];
            cur_y = expl_y[i];
            if (cur_x < 0 || cur_x > EXPLOSION_MAX_X) { continue; }
            if (cur_y < 16 || cur_y > EXPLOSION_MAX_Y) { continue; }

            if (use_b != 0) { bob = expl_bobs_b[i]; }
            else            { bob = expl_bobs_a[i]; }

            call PasteBob(bob, cur_x, cur_y, 1);

            if (use_b != 0)
            {
                expl_prev_x_b[i] = cur_x;
                expl_prev_y_b[i] = cur_y;
                expl_prev_valid_b[i] = 1;
            }
            else
            {
                expl_prev_x_a[i] = cur_x;
                expl_prev_y_a[i] = cur_y;
                expl_prev_valid_a[i] = 1;
            }
        }

    }

    // Erase previous meteor BOBs for current buffer.
    proc erase_meteors_on_current_screen(use_b:byte) -> void {
        var i:int;
        var bob:int;
        var prev_x:u16;
        var prev_y:u16;
        var prev_valid:int;

        for i = 0 to MAX_METEORS - 1
        {
            if (use_b != 0)
            {
                if (meteor_type[i] == ALIEN_TYPE_METEOR && meteor_prev_dir_b[i] == METEOR_DIR_RIGHT) { bob = meteor_bobs_right_b[i]; }
                else { bob = meteor_bobs_b[i]; }
                prev_x = meteor_prev_x_b[i];
                prev_y = meteor_prev_y_b[i];
                prev_valid = meteor_prev_valid_b[i];
            }
            else
            {
                if (meteor_type[i] == ALIEN_TYPE_METEOR && meteor_prev_dir_a[i] == METEOR_DIR_RIGHT) { bob = meteor_bobs_right_a[i]; }
                else { bob = meteor_bobs_a[i]; }
                prev_x = meteor_prev_x_a[i];
                prev_y = meteor_prev_y_a[i];
                prev_valid = meteor_prev_valid_a[i];
            }

            if (prev_valid != 0)
            {
                if (use_b != 0) { call patch_alien_bob(bob, meteor_type[i], meteor_prev_dir_b[i]); }
                else            { call patch_alien_bob(bob, meteor_type[i], meteor_prev_dir_a[i]); }
                call PasteBackground(bob, prev_x, prev_y);
            }

            if (use_b != 0) { meteor_prev_valid_b[i] = 0; }
            else { meteor_prev_valid_a[i] = 0; }
        }
    }

    // Capture backgrounds for active meteors before any dynamic draw.
    proc capture_meteors_background_on_current_screen(use_b:byte) -> void {
        var i:int;
        var bob:int;
        var cur_x:int;
        var cur_y:int;

        for i = 0 to MAX_METEORS - 1
        {
            if (use_b != 0)
            {
                if (meteor_type[i] == ALIEN_TYPE_METEOR && meteor_dir[i] == METEOR_DIR_RIGHT) { bob = meteor_bobs_right_b[i]; }
                else { bob = meteor_bobs_b[i]; }
            }
            else
            {
                if (meteor_type[i] == ALIEN_TYPE_METEOR && meteor_dir[i] == METEOR_DIR_RIGHT) { bob = meteor_bobs_right_a[i]; }
                else { bob = meteor_bobs_a[i]; }
            }

            if (meteor_active[i] == 0) { continue; }
            if (meteor_x[i] > METEOR_START_X || meteor_x[i] < 0) { continue; }

            cur_x = meteor_x[i];
            cur_y = meteor_y[i];
            call patch_alien_bob(bob, meteor_type[i], meteor_dir[i]);
            call GetBobBackground(bob, cur_x, cur_y);
        }
    }

    // Draw all active meteors for current buffer.
    proc draw_meteors_on_current_screen(use_b:byte) -> void {
        var i:int;
        var bob:int;
        var cur_x:int;
        var cur_y:int;

        for i = 0 to MAX_METEORS - 1
        {
            if (use_b != 0)
            {
                if (meteor_type[i] == ALIEN_TYPE_METEOR && meteor_dir[i] == METEOR_DIR_RIGHT) { bob = meteor_bobs_right_b[i]; }
                else { bob = meteor_bobs_b[i]; }
            }
            else
            {
                if (meteor_type[i] == ALIEN_TYPE_METEOR && meteor_dir[i] == METEOR_DIR_RIGHT) { bob = meteor_bobs_right_a[i]; }
                else { bob = meteor_bobs_a[i]; }
            }

            if (meteor_active[i] == 0) { continue; }

            // Keep draw X in [0..288] to avoid partial off-screen 32px BOB blits.
            if (meteor_x[i] > METEOR_START_X || meteor_x[i] < 0) { continue; }

            cur_x = meteor_x[i];
            cur_y = meteor_y[i];
            call patch_alien_bob(bob, meteor_type[i], meteor_dir[i]);
            call PasteBob(bob, cur_x, cur_y, 1);

            if (use_b != 0)
            {
                meteor_prev_x_b[i] = cur_x;
                meteor_prev_y_b[i] = cur_y;
                meteor_prev_valid_b[i] = 1;
                meteor_prev_dir_b[i] = meteor_dir[i];
            }
            else
            {
                meteor_prev_x_a[i] = cur_x;
                meteor_prev_y_a[i] = cur_y;
                meteor_prev_valid_a[i] = 1;
                meteor_prev_dir_a[i] = meteor_dir[i];
            }
        }
    }

code level_code:

    proc GetTileAt(x:u8, y:u8) -> u8
    {
        // Bounds check
        if (x >= MAP_WIDTH || y >= MAP_HEIGHT)
        {
            return 255;  // Out of bounds - treat as obstacle
        }
        
        // Get tile from map (assuming map1 for now)
        return map_data[y * MAP_WIDTH + x];
    }

    proc IsPositionWalkable(x:u16, y:u16, area:u8) -> u8
    {
        var tile:u8;
        var check_x:u8;
        var check_y:u8;
        var tx:u8;
        var ty:u8;
        
        check_x = (x >> 4);  // x / 16
        check_y = (y >> 4);  // y / 16

        for ty = 0 to area
        {
            for tx = 0 to area
            {
                tile = GetTileAt(check_x + tx, check_y + ty);
                
                // tile 0 is empty air; any non-zero tile is solid
                if (tile != 0)
                {
                    return 0;  // Solid tile blocks movement
                }
            }
        }
        
        return 1;  // Walkable
    }

    proc CreateMap(level:byte) -> void
    {
        var x:u16;
        var y:u16;
        var tile:u8;
        var map_level:int;
        var map_ptr:byte*;

        call ClearLevelBuffer();

        current_level = level;
        if (current_level < 1) { current_level = 1; }
        if (current_level > MAX_GAME_LEVEL) { current_level = MAX_GAME_LEVEL; }
        map_level = ((current_level - 1) % MAX_LEVELS) + 1;

        // Select map data based on level
        if (map_level == 1)
        {
            map_data = &map1;
        }
        else if (map_level == 2)
        {
            map_data = &map2;
        }
        else if (map_level == 3)
        {
            map_data = &map3;
        }
        else if (map_level == 4)
        {
            map_data = &map4;
        }
        else if (map_level == 5)
        {
            map_data = &map5;
        }
        else
        {
            // Default to map1 if level not recognized
            map_data = &map1;
        }
        rocket_fuel = 0;
        rocket_assembled = 1;
        rocket_part_state = 2;
        rocket_part_carried = 0;
        rocket_part_to_rocket = 0;
        rocket_part_prev_valid_a = 0;
        rocket_part_prev_valid_b = 0;
        rocket_part_source_clear_a = 0;
        rocket_part_source_clear_b = 0;
        if (((current_level - 1) % 5) == 0)
        {
            rocket_assembled = 0;
            rocket_part_state = 0;
        }

        // Load global into typed local for array access
        map_ptr = map_data;

        // Create the map
        for y = 0 to MAP_HEIGHT - 1
        {
            for x = 0 to MAP_WIDTH - 1
            {
                tile = map_ptr[y * MAP_WIDTH + x];
                if( tile == 0)
                {
                    continue; // Skip empty tiles (this extends d0 to long!)
                }

                asm {
                    ; Get tile code from map_data (is now in d0)
                    ;clr.l d0
                    ;move.b @tile,d0
                    
                    ; Get logical 16x16 tile index (already in d0 from tile variable)
                    subq.l #1,d0            ; Adjust tile index (tiles start from 1 in map)
                    
                    ; Clamp to valid range (0-63): 8x8 logical tiles
                    cmp.l #64,d0
                    blt.s .tile_valid
                    moveq #0,d0             ; Out of range - use tile 0
.tile_valid:

                    ; Convert logical 16x16 tile index to base 8x8 chunk index.
                    ; 8x8 chunk grid is 16x16. Logical tiles are 8x8 (2x2 chunks each).
                    ; base = (tile_y * 32) + (tile_x * 2)
                    move.l d0,d5
                    andi.l #7,d5            ; tile_x in logical grid (0..7)
                    add.l d5,d5             ; tile_x * 2
                    move.l d0,d6
                    lsr.l #3,d6             ; tile_y in logical grid (0..7)
                    mulu.w #32,d6           ; tile_y * (2 * 16 chunks per row)
                    add.l d6,d5             ; d5 = base 8x8 chunk index

                    ; Calculate screen destination address
                    ; Screen is line-interleaved: 320 pixels (40 bytes) wide, 5 bitplanes
                    ; Each screen row = 40 bytes × 5 planes = 200 bytes
                    move.l #level_screen,a0
                    move.w @y,d0
                    ext.l d0
                    mulu.w #(16*40*5),d0    ; y * 3200 bytes (16 pixel rows per tile * 200 bytes per screen row)
                    
                    move.w @x,d1
                    ext.l d1
                    add.l d1,d1             ; 2 bytes per 16px tile horizontally
                    add.l d1,d0
                    add.l d0,a0             ; a0 = screen base address for this tile

                    ; Draw top-left 8x8 chunk (base + 0)
                    move.l #jetpack_tileset,a1
                    move.l d5,d0
                    mulu.w #40,d0
                    add.l d0,a1
                    movea.l a0,a2
                    moveq #(8-1),d7
.draw_tl_row:
                    move.b (a1)+,d0
                    move.b d0,(a2)
                    move.b (a1)+,d0
                    move.b d0,40(a2)
                    move.b (a1)+,d0
                    move.b d0,80(a2)
                    move.b (a1)+,d0
                    move.b d0,120(a2)
                    move.b (a1)+,d0
                    move.b d0,160(a2)
                    add.l #200,a2
                    dbf d7,.draw_tl_row

                    ; Draw top-right 8x8 chunk (base + 1)
                    move.l #jetpack_tileset,a1
                    move.l d5,d0
                    addq.l #1,d0
                    mulu.w #40,d0
                    add.l d0,a1
                    movea.l a0,a2
                    adda.l #1,a2
                    moveq #(8-1),d7
.draw_tr_row:
                    move.b (a1)+,d0
                    move.b d0,(a2)
                    move.b (a1)+,d0
                    move.b d0,40(a2)
                    move.b (a1)+,d0
                    move.b d0,80(a2)
                    move.b (a1)+,d0
                    move.b d0,120(a2)
                    move.b (a1)+,d0
                    move.b d0,160(a2)
                    add.l #200,a2
                    dbf d7,.draw_tr_row

                    ; Draw bottom-left 8x8 chunk (base + 16)
                    move.l #jetpack_tileset,a1
                    move.l d5,d0
                    add.l #16,d0
                    mulu.w #40,d0
                    add.l d0,a1
                    movea.l a0,a2
                    adda.l #1600,a2         ; 8 rows down
                    moveq #(8-1),d7
.draw_bl_row:
                    move.b (a1)+,d0
                    move.b d0,(a2)
                    move.b (a1)+,d0
                    move.b d0,40(a2)
                    move.b (a1)+,d0
                    move.b d0,80(a2)
                    move.b (a1)+,d0
                    move.b d0,120(a2)
                    move.b (a1)+,d0
                    move.b d0,160(a2)
                    add.l #200,a2
                    dbf d7,.draw_bl_row

                    ; Draw bottom-right 8x8 chunk (base + 17)
                    move.l #jetpack_tileset,a1
                    move.l d5,d0
                    add.l #17,d0
                    mulu.w #40,d0
                    add.l d0,a1
                    movea.l a0,a2
                    adda.l #1601,a2         ; 8 rows down + 1 byte right
                    moveq #(8-1),d7
.draw_br_row:
                    move.b (a1)+,d0
                    move.b d0,(a2)
                    move.b (a1)+,d0
                    move.b d0,40(a2)
                    move.b (a1)+,d0
                    move.b d0,80(a2)
                    move.b (a1)+,d0
                    move.b d0,120(a2)
                    move.b (a1)+,d0
                    move.b d0,160(a2)
                    add.l #200,a2
                    dbf d7,.draw_br_row
                }
            }
        }
    }

    proc ClearLevelBuffer() -> void
    {
        asm {
            move.l #level_screen,a0
            move.l #320*256/32*5-1,d0
            moveq #0,d1
.l1:        move.l d1,(a0)+
            dbra d0,.l1
        }
    }

    proc CopyLevelBuffer() -> void
    {
        asm {
            move.l #level_screen,a0
            move.l gfx_current_screen_ptr,a1
            move.l #320*256/32*5-1,d0
.copy_loop:
            move.l (a0)+,(a1)+
            dbra d0,.copy_loop
        }
    }

