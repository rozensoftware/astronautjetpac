// ── Meteor / alien enemy system ────────────────────────────────────────────
// meteor_spawn_timer: counts down to 0, then one new meteor is spawned.
// prng_seed:          Galois-LFSR state; pre-initialised to a non-zero value.

data debug_strings:
    dbg_err_setgfx.b      = "[ERR] SetGraphicsMode failed", 0
    dbg_err_load_assets.b = "[ERR] load_all_assets failed", 0
    dbg_err_meteor_bobs.b = "[ERR] load_meteor_bobs failed", 0
    dbg_err_expl_bobs.b   = "[ERR] load_explosion_bobs failed", 0
    dbg_err_expl_alloc_a.b = "[ERR] expl CreateBob A failed at slot", 0
    dbg_err_expl_alloc_b.b = "[ERR] expl CreateBob B failed at slot", 0
    dbg_err_load_letters.b = "[ERR] load_bob_letters failed", 0
    dbg_err_sprites.b = "[ERR] load_all_sprites failed", 0

data meteor_data:
    meteor_spawn_timer.w = 0
    prng_seed.l = $A5F3C1E7

// Parallel arrays, one entry per meteor slot (index 0 .. MAX_METEORS-1).
// meteor_type allows future alien behaviours (1, 2 …) to share the same arrays.

bss meteor_bss:
    meteor_active.l[MAX_METEORS]
    meteor_type.l[MAX_METEORS]    // widened to .l to keep subsequent arrays long-word aligned
    meteor_dir.l[MAX_METEORS]
    meteor_vdir.l[MAX_METEORS]
    meteor_vtimer.l[MAX_METEORS]
    meteor_x.l[MAX_METEORS]
    meteor_y.l[MAX_METEORS]
    meteor_bobs_a.l[MAX_METEORS]
    meteor_bobs_b.l[MAX_METEORS]
    meteor_bobs_right_a.l[MAX_METEORS]
    meteor_bobs_right_b.l[MAX_METEORS]
    meteor_prev_x_a.l[MAX_METEORS]
    meteor_prev_y_a.l[MAX_METEORS]
    meteor_prev_valid_a.l[MAX_METEORS]
